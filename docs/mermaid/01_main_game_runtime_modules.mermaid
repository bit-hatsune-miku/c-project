sequenceDiagram
    participant Player
    participant Main as main.cpp
    participant App as AppState
    participant Menu as Menu / Settings / Load UI
    participant VN as VN System
    participant Save as Save System
    participant Demo as battle::demo::Session

    Player->>Main: Launch executable
    Main->>Main: Create Window
    Main->>VN: initialize(renderer, width, height)
    Main->>Save: init()
    Main->>App: create AppState(screen = MainMenu)
    Main->>Menu: load menu resources

    loop Main loop
        Player->>Main: SDL event
        Main->>App: inspect screen

        alt screen == MainMenu
            Main->>Menu: handleMainMenuEvent(...)
            alt Start selected
                Main->>VN: load chapter script if needed
                Main->>App: story.entryIndex = 0
                Main->>VN: showLine(...) from current ScriptEntry
                Main->>Save: autosave(current story progress)
                Main->>App: screen = Playing
            else Load selected
                Main->>App: screen = LoadMenu
            else Settings selected
                Main->>App: screen = Settings
            else Battle selected
                Main->>App: screen = BattleDemo
            end

        else screen == Playing
            alt Space pressed
                Main->>VN: onSpacePressed()
            else Escape pressed
                Main->>App: screen = PauseMenu
            else F11 pressed
                Main->>Menu: applyDisplayMode(...)
            end

            Main->>VN: update(deltaSeconds)
            VN-->>Main: consumeAdvanceRequest()

            alt VN advance request consumed
                Main->>App: story.entryIndex++
                alt current ScriptEntry has battleId
                    Main->>App: beginBattle(battleId)
                    Main->>App: screen = BattleDemo
                else more story entries remain
                    Main->>VN: showLine(...) for next ScriptEntry
                    opt background changed
                        Main->>Save: autosave(current story progress)
                    end
                else reached end of story
                    Main->>App: screen = MainMenu
                end
            end

        else screen == PauseMenu
            Main->>Menu: handlePauseMenuEvent(...)
            alt Save requested
                Main->>Save: findMatchingManualSavePath(...)
                alt duplicate exists
                    Main->>App: screen = PauseConfirmOverwriteSave
                else no duplicate
                    Main->>Save: manualSave(...)
                end
            else Load requested
                Main->>App: screen = LoadMenu
            else Settings requested
                Main->>App: screen = Settings
            else Exit requested
                Main->>App: screen = PauseConfirmExit
            end

        else screen == LoadMenu
            Main->>Menu: handleLoadMenuEvent(...)
            opt slot chosen
                Main->>Save: load(path)
                alt load succeeds
                    Main->>VN: reset()
                    Main->>VN: setVoiceVolume(...)
                    Main->>VN: setTypewriterSpeed(...)
                    Main->>VN: showLine(...) for restored ScriptEntry
                    Main->>App: screen = Playing
                else load fails
                    Main->>App: noticeText = Load failed / corrupted
                end
            end

        else screen == BattleDemo
            opt first frame entering battle
                Main->>Menu: destroy menu resources
                Main->>VN: stopVoicePlayback()
                Main->>Demo: initialize(renderer, battleKey)
            end

            Main->>Demo: handleEvent(event)
            Main->>Demo: update(deltaSeconds)
            Main->>Demo: render(renderer, width, height)
            Demo-->>Main: isFinished()

            alt battle session finished
                Main->>Demo: shutdown()
                Main->>Main: restoreRendererUi()
                Main->>App: screen = MainMenu
            end
        end
    end
