flowchart TD
    A["demo.cpp<br/>Standalone battle entry"] --> B["battle::demo::Session<br/>demo_battle_session.cpp"]

    B --> C["BattlePartySetupScreen<br/>optional team selection"]
    B --> D["DemoNarrativeFlow<br/>tutorial dialogue only"]
    B --> E["BattleSessionCore<br/>shared battle runtime"]

    E --> F["BattleManager<br/>battle state + turn flow"]
    E --> G["Presentation system<br/>AbilityPresentation + PresentationRegistry"]
    E --> H["Render / HUD / Feedback<br/>world renderer, camera, battle UI"]

    F --> I["Battle Loader<br/>bosses, characters, battles, abilities JSON"]
    F --> J["Turn System<br/>speed and action-value order"]
    F --> K["Ability System<br/>damage, heal, shield, buff"]

    K --> G
    G --> E
    D --> E

    I --> L["assets/combat/*.json"]
    G --> M["presentation classes<br/>src/game/presentation/"]
    H --> N["sprites, icons, voices, BGM"]

    B -.hooks / callbacks.-> E
