flowchart TD
    A["demo_lyoo_plot_twist<br/>battleKey = lyoo_plot_twist"] --> B["load BattleDefinition"]
    B --> C["boss = lyooPlotTwist<br/>isLineupFixed = true<br/>lineup = wechatalipay, cupcakke, jiafei, lyoo"]
    C --> D["BattlePartySetupScreen.initialize()"]
    D --> E["Fixed lineup -> skip setup -> auto-start"]
    E --> F["startBattleWithParty(wechatalipay, cupcakke, jiafei, lyoo)"]

    F --> G["narrativeEnabled_ = false"]
    G --> H["BattleSessionCore hooks attached"]
    H --> H1["onPreUpdate -> processAutomaticTurns()"]
    H --> H2["onPresentationAudioCommands -> loop SFX / pause-resume BGM"]
    H --> H3["onPresentationEnd -> if presentationId = boss_attack_lyoo_plot_twist then resume normal BGM"]

    H3 --> I["BattleSessionCore.initialize(...)"]
    I --> J["Combat begin animation"]
    J --> K["Main combat runtime"]

    K --> L["Player acts"]
    L --> M["If presentationId = boss_attack_lyoo_plot_twist<br/>presentation-specific audio commands drive dramatic sequence"]
    M --> N["BattleActionEvent stream consumed for voice and hit playback"]
    N --> O["Shared renderer draws world, HUD, feedback, splash, presentations"]

    O --> P{"Battle over?"}
    P -->|No| K
    P -->|Yes| Q["Session finished"]
