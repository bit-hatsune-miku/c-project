flowchart TD
    A["demo_wechatalipay<br/>battleKey = scan_to_pay"] --> B["load BattleDefinition"]
    B --> C["boss = wechatalipayBoss<br/>isLineupFixed = true<br/>lineup = wechatalipay, cupcakke, jiafei, lyoo"]
    C --> D["BattlePartySetupScreen.initialize()"]
    D --> E["Fixed lineup -> skip setup -> auto-start"]
    E --> F["startBattleWithParty(wechatalipay, cupcakke, jiafei, lyoo)"]

    F --> G["narrativeEnabled_ = false"]
    G --> H["Shared hooks installed"]
    H --> H1["onPreUpdate -> processAutomaticTurns()"]
    H --> H2["onPresentationAbilityAudio -> boss/party voice timing"]
    H --> H3["onPresentationHitAudio -> boss hit/dead voice logic"]
    H --> H4["onPresentationEnd -> clear or set HUD hints"]

    H4 --> I["BattleSessionCore.initialize(...)"]
    I --> J["Main combat loop"]
    J --> K["Player actions and boss actions resolved by BattleManager"]
    K --> L["Shield-centric abilities and Wechatalipay presentation logic run"]
    L --> M["Presentation callbacks control extra audio / loop playback"]
    M --> N["Shared renderer and HUD draw battle state"]
    N --> O{"Battle over?"}
    O -->|No| J
    O -->|Yes| P["Session finished"]
