flowchart TD
    A["demo_battle_session initialize<br/>battleKey = tutorial_vs_lyoo"] --> B["load BattleDefinition"]
    B --> C["type = tutorial<br/>boss = lyooBoss<br/>partySize = 4<br/>lockedLineup = miku<br/>available lineup = miku, cupcakke, lyoo, iroha"]
    C --> D["BattlePartySetupScreen.initialize()"]
    D --> E{"isLineupFixed?"}
    E -->|No| F["Party setup UI stays active"]

    F --> F1["Player can select up to 4 party members<br/>Miku stays locked in lineup"]
    F1 --> F2["Start button -> consumeStartRequest()"]
    F2 --> G["startBattleWithParty(selectedKeys)"]

    G --> H["Build BattleSessionCore::Hooks"]
    H --> H1["isDialogueInProgress -> DemoNarrativeFlow"]
    H --> H2["onSpacePressed -> advance VN dialogue"]
    H --> H3["isSpaceEnabledForBattle -> battle input gated by tutorial"]
    H --> H4["onPlayerTurnExecuted -> check Miku milestones"]
    H --> H5["onPreUpdate -> vn::update + automatic progression + consume battle events"]
    H --> H6["onPostRender -> vn::render during dialogue"]
    H --> H7["presentation audio hooks -> voices, hit audio, BGM control"]

    H7 --> I["BattleSessionCore.initialize(renderer, bossKey, lineup, hooks)"]
    I --> J["Combat begin animation"]
    J --> K["DemoNarrativeFlow.initialize()"]
    K --> K1["Load intro + post-skill + post-ultimate + post-Lyoo-attack + boss-defeated dialogue JSON"]
    K1 --> L["Intro dialogue starts<br/>battle input disabled"]

    L --> M["Main update loop"]
    M --> M1{"Dialogue active?"}
    M1 -->|Yes| M2["Space advances VN line<br/>battle input blocked"]
    M1 -->|No| M3["BattleSessionCore handles turn preview, input, rendering"]

    M3 --> N{"Player turn executed?"}
    N -->|Miku first skill| O["Start postMikuSkillDialogueLines<br/>pause battle progression"]
    N -->|Miku first ultimate extra turn| P["Start postMikuUltimateDialogueLines<br/>set pending Lyoo follow-up tutorial"]
    N -->|Other player turn| Q["Allow automatic turns if no pending tutorial gate"]

    Q --> R["Automatic progression"]
    R --> R1{"Pending post-Lyoo tutorial and next actor is boss?"}
    R1 -->|Yes| S["processAutomaticTurns() once for Lyoo action"]
    S --> T["Start postLyooAttackAfterMikuUltimateDialogueLines"]
    R1 -->|No| U["Normal automatic boss / extra-turn processing"]

    U --> V{"Boss defeated?"}
    V -->|Yes| W["Start bossDefeatedDialogueLines"]
    W --> X["Final dialogue closes"]
    X --> Y["core_.isFinished() -> session ends"]
    V -->|No| M
    O --> M
    P --> M
    T --> M
