{
  "chapter": 99,
  "title": "Finale Phase 3",
  "entries": [
    {
      "speaker": "Miku",
      "voiceSpeakerId": "miku",
      "text": "I know now!",
      "type": "dialogue",
      "voice": "assets/vn/voices/finale_phase3/1.wav",
      "icon": "assets/combat/icons/miku.png",
      "battleFocus": "miku"
    },
    {
      "speaker": "Miku",
      "voiceSpeakerId": "miku",
      "text": "Hey you bitch!",
      "type": "dialogue",
      "voice": "assets/vn/voices/finale_phase3/2.wav",
      "icon": "assets/combat/icons/miku.png",
      "battleFocus": "miku"
    },
    {
      "speaker": "Miku",
      "voiceSpeakerId": "miku",
      "text": "All this time you were talking to me... you actually weren't talking to me were you?",
      "type": "dialogue",
      "background": "assets/combat/presentations/special/1.png",
      "voice": "assets/vn/voices/finale_phase3/3.wav",
      "icon": "assets/combat/icons/miku.png",
      "battleFocus": "miku"
    },
    {
      "speaker": "Lyoo",
      "voiceSpeakerId": "lyooPlotTwist",
      "text": "?",
      "type": "dialogue",
      "icon": "assets/combat/icons/lyoo.png",
      "battleFocus": "boss"
    },
    {
      "speaker": "Miku",
      "voiceSpeakerId": "miku",
      "text": "You were talking to him, weren't you?",
      "type": "dialogue",
      "background": "assets/combat/presentations/special/2.png",
      "voice": "assets/vn/voices/finale_phase3/4.wav",
      "icon": "assets/combat/icons/miku.png",
      "battleFocus": "miku"
    },
    {
      "speaker": "Miku",
      "voiceSpeakerId": "miku",
      "text": "The dreaming child you left behind.",
      "type": "dialogue",
      "voice": "assets/vn/voices/finale_phase3/5.wav",
      "icon": "assets/combat/icons/miku.png",
      "battleFocus": "miku"
    },
    {
      "speaker": "Miku",
      "voiceSpeakerId": "miku",
      "text": "I have a question for you.",
      "type": "dialogue",
      "clearBackground": true,
      "voice": "assets/vn/voices/finale_phase3/6.wav",
      "icon": "assets/combat/icons/miku.png",
      "battleFocus": "miku"
    },
    {
      "speaker": "Miku",
      "voiceSpeakerId": "miku",
      "text": "Why does water keep flowing in the river of broken dreams?",
      "type": "dialogue",
      "voice": "assets/vn/voices/finale_phase3/7.wav",
      "icon": "assets/combat/icons/miku.png",
      "battleFocus": "miku"
    },
    {
      "speaker": "Miku",
      "voiceSpeakerId": "miku",
      "text": "Because no matter how you try to bottle them inside, dreams NEVER FADE AWAY!",
      "type": "dialogue",
      "voice": "assets/vn/voices/finale_phase3/8.wav",
      "icon": "assets/combat/icons/miku.png",
      "battleFocus": "miku"
    },
    {
      "speaker": "Lyoo",
      "voiceSpeakerId": "lyooPlotTwist",
      "text": "SHUT UP!! SHUT UP SHUT UP SHUT UP",
      "type": "dialogue",
      "voice": "assets/vn/voices/finale_phase3/9.wav",
      "icon": "assets/combat/icons/lyoo.png",
      "battleFocus": "boss",
      "bossTitleOverride": "La Riviere aux Reves brisee"
    },
    {
      "speaker": "Lyoo",
      "voiceSpeakerId": "lyooPlotTwist",
      "text": "WHAT GIVES YOU THE RIGHT TO HAVE A DREAM? THERE IS NO SUCH THING AS DREAM IN THIS MUNDANE WORLD",
      "type": "dialogue",
      "voice": "assets/vn/voices/finale_phase3/10.wav",
      "icon": "assets/combat/icons/lyoo.png",
      "battleFocus": "boss"
    },
    {
      "speaker": "Lyoo",
      "voiceSpeakerId": "lyooPlotTwist",
      "text": "IF I COULDN'T MAKE MY DREAMS COME TRUE, I'LL MAKE SURE THAT NO ONE, NOBODY NOT A SINGLE PERSON DOES",
      "type": "dialogue",
      "voice": "assets/vn/voices/finale_phase3/11.wav",
      "icon": "assets/combat/icons/lyoo.png",
      "battleFocus": "boss"
    },
    {
      "speaker": "Lyoo",
      "voiceSpeakerId": "lyooPlotTwist",
      "text": "AND THAT INCLUDES....",
      "type": "dialogue",
      "background": "assets/combat/presentations/special/1.png",
      "voice": "assets/vn/voices/finale_phase3/12.wav",
      "icon": "assets/combat/icons/lyoo.png",
      "battleFocus": "boss"
    },
    {
      "speaker": "Lyoo",
      "voiceSpeakerId": "lyooPlotTwist",
      "text": "THAT INCLUDES YOU!",
      "type": "dialogue",
      "background": "assets/combat/presentations/special/2.png",
      "voice": "assets/vn/voices/finale_phase3/13.wav",
      "icon": "assets/combat/icons/lyoo.png",
      "battleFocus": "boss"
    },
    {
      "type": "dialogue",
      "scriptedAction": "lyoo_phase3_attack",
      "clearBackground": true
    },
    {
      "speaker": "Miku",
      "voiceSpeakerId": "miku",
      "text": "He's vulnerable, now!",
      "type": "dialogue",
      "voice": "assets/vn/voices/finale_phase3/17.wav",
      "autoAdvanceOnVoiceEnd": true,
      "icon": "assets/combat/icons/miku.png",
      "battleFocus": "miku"
    },
    {
      "type": "dialogue",
      "scriptedAction": "miku_phase3_finisher"
    }
  ]
}
