{
  "chapter": 5,
  "title": "Luotianyi Victory",
  "scriptId": "ch0501",
  "endReturnScreen": "selector",
  "entries": [
    {
      "speaker": "Luo Tianyi",
      "text": "Wow, Miku-JieJie... that high note you hit at the end was incredible. I’ve never heard a frequency like that.",
      "type": "dialogue",
      "background": "assets/vn/backgrounds/ch5/1.png",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "CupcakKe",
      "text": "That was a diandong, do you acutally think she can hit high notes?",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Miku",
      "text": "Thanks. I was just... I was jealous, Tianyi. I thought if you were \"perfect,\" then I was a failure. But seeing you perform, I realize you work just as hard as I do.",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Luo Tianyi",
      "text": "Let’s not fight anymore. You have a legacy, and I have a future. We should actually collab together sometime! A Japanese-Chinese Vocaloid fusion track would be a total bop.",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Miku",
      "text": "I’d love that! Seriously. Wait, I want to say something cool in Chinese to show I’m serious.",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "CupcakKe",
      "text": "Go for it, Miku! Show her that bilingual energy.",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Miku",
      "text": "Nǐ... hěn... PÀNG!",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Luo Tianyi",
      "text": "awkard smile",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Luo Tianyi",
      "text": "Did you mean 棒 bàng… by any chance….",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "CupcakKe",
      "text": "You called her a fatass",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Miku",
      "text": "FUCK",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Luo Tianyi",
      "text": "…let’s just stick to singing for now, Miku-JieJie… you don’t need to sing in Chinese either….",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    }
