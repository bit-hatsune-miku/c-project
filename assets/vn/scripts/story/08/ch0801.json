{
  "chapter": 8,
  "title": "Zhao Laoshi Intro",
  "scriptId": "ch0801",
  "endReturnScreen": "selector",
  "entries": [
    {
      "speaker": "Miku",
      "text": "Why is our teacher at an idol competition?!",
      "type": "dialogue",
      "background": "assets/vn/backgrounds/deadline/zhao_story.png",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false,
      "bgm": "assets/combat/bgm/randyStory.wav",
      "bgmVolume": 0.3
    },
    {
      "speaker": "Zhao Laoshi",
      "text": "Why are you skipping computer science classes?",
      "type": "dialogue",
      "background": "",
      "voice": "assets/combat/voices/randy/ability.opus",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Miku",
      "text": "That is NOT an answer to my question!",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Zhao Laoshi",
      "text": "And \"I was doing singer research\" is NOT a good answer to mine.",
      "type": "dialogue",
      "background": "",
      "voice": "assets/combat/voices/randy/ability.opus",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Miku",
      "text": "I was NOT skipping! I was doing... field research! For performance studies!",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Zhao Laoshi",
      "text": "Your attendance is doing field research too. It has not been seen in weeks.",
      "type": "dialogue",
      "background": "",
      "voice": "assets/combat/voices/randy/ability.opus",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Miku",
      "text": "Why does your voice line sound EXACTLY the same even when you're saying DIFFERENT things?!",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Zhao Laoshi",
      "text": "Because the developers do not have time to watch the class replay on YanheKT.",
      "type": "dialogue",
      "background": "",
      "voice": "assets/combat/voices/randy/ability.opus",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Miku",
      "text": "Why does every chapter keep breaking the fourth wall?!",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Zhao Laoshi",
      "text": "Because every chapter also keeps breaking my patience.",
      "type": "dialogue",
      "background": "",
      "voice": "assets/combat/voices/randy/ability.opus",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Zhao Laoshi",
      "text": "You have interest. You do NOT have discipline. That is a very dangerous combination.",
      "type": "dialogue",
      "background": "",
      "voice": "assets/combat/voices/randy/ability.opus",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Zhao Laoshi",
      "text": "Then get on stage, and code in C, until your last breath! And without Claude or Codex!",
      "type": "dialogue",
      "background": "",
      "voice": "assets/combat/voices/randy/ability.opus",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Miku",
      "text": "That doesn't even match the competition!",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Zhao Laoshi",
      "text": "Neither does your attendance record. Begin.",
      "type": "dialogue",
      "background": "",
      "voice": "assets/combat/voices/randy/ability.opus",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false,
      "battleKey": "randy"
    }
  ]
}
