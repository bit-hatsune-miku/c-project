{
  "chapter": 2,
  "title": "Teto Intro",
  "scriptId": "ch0201",
  "endReturnScreen": "selector",
  "entries": [
    {
      "speaker": "Miku",
      "text": "Teto?! What the hell are YOU doing in the underground campus?!",
      "type": "dialogue",
      "background": "assets/vn/backgrounds/deadline/teto_story.png",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false,
      "bgm": "assets/combat/bgm/tetoStory.wav",
      "bgmVolume": 0.3
    },
    {
      "speaker": "Teto",
      "text": "N-none of your business!!!",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Miku",
      "text": "Wait... were you seriously sneaking into the idol competition?!",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Teto",
      "text": "I was NOT sneaking! I was just checking the route... and maybe the stage... and maybe the sign-up board... Ugh!!!",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Miku",
      "text": "Oho! So you DID want to compete!!!",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Teto",
      "text": "Shut up! You're so loud! Why do you have to make everything such a whole production?!",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Miku",
      "text": "Because I'm Hatsune Miku! Also... are you mad because I'm annoying, or because I get to do the thing you want to do too?",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Teto",
      "text": "...I hate how easy you make it look, okay? You walk on stage like you belong there. I have to fight not to freak out just standing near one.",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Miku",
      "text": "Then stand near one anyway! If you want to sing, then sing!!!",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Teto",
      "text": "Don't say insane things like that so casually...",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Miku",
      "text": "Then prove you can do it, roommate!!!",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Teto",
      "text": "Fine! Get on stage, and sing until your last breath!",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false,
      "battleKey": "roomateConflicts"
    }
  ]
}
