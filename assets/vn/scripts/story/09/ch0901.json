    {
      "speaker": "Sailor Venus",
      "text": "I am Minako Aino, also known as Sailor Venus, agent of love and beauty!",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
