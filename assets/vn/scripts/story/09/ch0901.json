      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Sailor Venus",
      "text": "Because I am radiant enough to survive it.",
