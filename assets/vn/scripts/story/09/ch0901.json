      "background": "",
      "voice": "",
      "fontPath": "",
      "icon": "",
      "iconFrameCount": 1,
      "iconFps": 8.0,
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Miku",
      "text": "Why would a magical girl reveal her own identity like that?",
