{
  "chapter": 99,
  "scriptId": "finale02",
  "title": "Finale: Farewell",
  "credits": true,
  "entries": [
    {
      "speaker": "Cupcakke",
      "text": "Is this how things have to end? Miku…",
      "type": "dialogue",
      "background": "assets/vn/backgrounds/finale/4.png",
      "voice": "assets/vn/voices/finale2/1.opus",
      "autoAdvanceOnVoiceEnd": false,
      "bgm": "assets/vn/bgm/finale/farewellMiku.opus",
      "bgmVolume": 0.3
    },
    {
      "speaker": "Miku",
      "text": "You were the best thing that could’ve happened to me in this life, I am so glad to have you as my best friend….",
      "type": "dialogue",
      "background": "",
      "voice": "assets/vn/voices/finale2/2.opus",
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Miku",
      "text": "My last wish.. is for you to become a world famous singer… Even if all you can sing is \"vagina augh\"...",
      "type": "dialogue",
      "background": "",
      "voice": "assets/vn/voices/finale2/3.opus",
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Cupcakke",
      "text": "MIKU…",
      "type": "dialogue",
      "background": "",
      "voice": "assets/vn/voices/finale2/4.opus",
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Miku",
      "text": "Please, carry on my dream, never let it fade away.",
      "type": "dialogue",
      "background": "",
      "voice": "assets/vn/voices/finale2/5.opus",
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Cupcakke",
      "text": "No…..",
      "type": "dialogue",
      "background": "",
      "voice": "assets/vn/voices/finale2/6.opus",
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Miku",
      "text": "Farewell, Cupcakke, Sayonara…",
      "type": "dialogue",
      "background": "",
      "voice": "assets/vn/voices/finale2/7.opus",
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Miku",
      "text": "Oh, and make a claim to the PingAn insurance, you can take all the money, it’s like a gazillion RMB.",
      "type": "dialogue",
      "background": "",
      "voice": "assets/vn/voices/finale2/8.opus",
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Cupcakke",
      "text": "MKU… NOOOOOOOO…",
      "type": "dialogue",
      "background": "#000000",
      "voice": "assets/vn/voices/finale2/9.opus",
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "",
      "text": "A few days later, once everything returns to normal...",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "autoAdvanceOnVoiceEnd": false,
      "bgmVolume": 0,
      "bgmPause": true
    },    
    {
      "speaker": "Cupcakke",
      "text": "So you see, in order to honour my deceased best friend, she is now the logo of https://bitshare.com.cn/.",
      "type": "dialogue",
      "background": "assets/vn/backgrounds/finale/5.png",
      "voice": "assets/vn/voices/finale2/10.opus",
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Timothy",
      "text": "Are you serious? Is this how you want to end the story?",
      "type": "dialogue",
      "background": "#000000",
      "voice": "",
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Anmol",
      "text": "That’s such a shitty ending bro",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "autoAdvanceOnVoiceEnd": false
    },
    {
       "speaker": "Revell",
      "text": "Yeah like, what kind of best friend does that??",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "autoAdvanceOnVoiceEnd": false       
    },
    {
       "speaker": "Russel",
      "text": "It's not that serious",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "autoAdvanceOnVoiceEnd": false       
    }, 
    {
        "speaker": "Jaden",
      "text": "",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "autoAdvanceOnVoiceEnd": false          
    },
    {
      "speaker": "Lyes",
      "text": "Listen, the deadline is tomorrow, we don’t have time anymore",
      "type": "dialogue",
      "background": "",
      "voice": "assets/vn/voices/finale2/15.opus",
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Lyes",
      "text": "Let’s just get this over with",
      "type": "dialogue",
      "background": "",
      "voice": "assets/vn/voices/finale2/16.opus",
      "autoAdvanceOnVoiceEnd": false
    },
    {
      "speaker": "Lyoo",
      "text": "Roll in the credits!",
      "type": "dialogue",
      "background": "",
      "voice": "",
      "autoAdvanceOnVoiceEnd": true
    }
  ]
}
