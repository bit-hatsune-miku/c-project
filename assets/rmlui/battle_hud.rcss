body {
    margin: 0;
    width: 100%;
    height: 100%;
    color: #f5efe2;
    background-color: transparent;
    font-family: "DejaVu Sans";
}

#stage {
    position: relative;
    width: 100%;
    height: 100%;
}

@keyframes active-turn-bounce {
    from {
        transform: translateX(0dp);
    }
    to {
        transform: translateX(12dp);
    }
}

@keyframes orb-missing-pulse {
    from {
        transform: scale(1.0);
        opacity: 0.45;
    }
    to {
        transform: scale(1.14);
        opacity: 1.0;
    }
}

@keyframes toast-rise {
    from {
        transform: translateY(10dp);
        opacity: 0;
    }
    to {
        transform: translateY(0dp);
        opacity: 1;
    }
}

.boss-shell {
    position: absolute;
    top: 26dp;
    left: 0;
    right: 0;
    width: 620dp;
    height: 74dp;
    margin-left: auto;
    margin-right: auto;
    background-color: rgba(8, 14, 24, 214);
    border: 1dp #b36a38;
    box-shadow: 0 0 18dp rgba(255, 124, 61, 52);
    overflow: hidden;
}

.boss-content {
    position: absolute;
    left: 26dp;
    right: 24dp;
    top: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6dp;
}

.boss-header {
    position: relative;
    display: flex;
    align-items: center;
}

.boss-name {
    position: relative;
    color: #fff5ec;
    font-size: 29dp;
    letter-spacing: 1dp;
}

.boss-percent {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    color: #fff1de;
    font-size: 18dp;
    letter-spacing: 1dp;
}

.boss-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background-color: rgba(197, 77, 72, 90);
}

.boss-orbs {
    position: relative;
    display: inline-flex;
    gap: 6dp;
}

.boss-orb {
    width: 10dp;
    height: 10dp;
    background-color: rgba(28, 46, 72, 220);
    border: 1dp #d8ecf7;
    border-radius: 10dp;
}

.boss-orb.full {
    background-color: #3db7ff;
}

.boss-orb.gold {
    background-color: #f0cd4d;
}

.boss-orb.hidden {
    display: none;
}

.turn-stack {
    position: absolute;
    top: 124dp;
    left: 26dp;
    width: 98dp;
    display: flex;
    flex-direction: column;
    gap: 12dp;
}

.turn-card {
    position: relative;
    width: 78dp;
    height: 54dp;
    margin-left: 10dp;
    background-color: rgba(10, 20, 33, 228);
    border: 1dp #294561;
    border-radius: 8dp;
    box-shadow: 0 0 10dp rgba(73, 121, 173, 22);
    overflow: hidden;
}

.turn-card.active {
    border-color: #ff9d57;
    box-shadow: 0 0 14dp rgba(255, 157, 87, 46);
    animation: 0.95s cubic-in-out infinite alternate active-turn-bounce;
}

.turn-card.boss {
    border-color: #8a3e3a;
}

.turn-card-accent {
    position: absolute;
    left: 0;
    top: 10dp;
    width: 4dp;
    height: 34dp;
    background-color: #54bfdc;
}

.boss-accent {
    background-color: #dc6154;
}

.turn-portrait {
    position: absolute;
    left: 9dp;
    top: -3dp;
    width: 62dp;
    height: 62dp;
}

.party-rack {
    position: absolute;
    left: 32dp;
    bottom: 42dp;
    width: 884dp;
    display: flex;
    gap: 20dp;
}

.unit-card {
    position: relative;
    width: 206dp;
    height: 138dp;
    background-color: rgba(9, 15, 25, 120);
    border: 0;
    overflow: hidden;
}

.unit-card.focus {
    box-shadow: 0 0 28dp rgba(255, 157, 87, 70);
}

.unit-card.ult-ready {
    box-shadow: 0 0 34dp rgba(242, 205, 77, 110);
    background-color: rgba(34, 24, 10, 132);
}

.unit-card.ghost {
    opacity: 0.96;
}

.unit-portrait {
    position: absolute;
    left: 0;
    top: 0;
    width: 138dp;
    height: 138dp;
}

.unit-fade-left {
    position: absolute;
    left: 0;
    top: 0;
    width: 52dp;
    height: 138dp;
    decorator: linear-gradient(to right, #070b14eb, #070b1400) border-box;
}

.unit-card.ult-ready .unit-fade-left {
    decorator: linear-gradient(to right, #8f6719f2, #8f671900) border-box;
}

.unit-fade-right {
    position: absolute;
    right: 0;
    top: 0;
    width: 52dp;
    height: 138dp;
    decorator: linear-gradient(to left, #070b14eb, #070b1400) border-box;
}

.unit-card.ult-ready .unit-fade-right {
    decorator: linear-gradient(to left, #8f6719f2, #8f671900) border-box;
}

.unit-fade-bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 58dp;
    decorator: linear-gradient(to top, #070b14e8, #070b1400) border-box;
}

.unit-card.ult-ready .unit-fade-bottom {
    decorator: linear-gradient(to top, #8f6719ed, #8f671900) border-box;
}

.hp-track {
    position: absolute;
    left: 14dp;
    bottom: 12dp;
    width: 174dp;
    height: 9dp;
    background-color: #1c2531;
    border: 1dp #2f4868;
}

.hp-track-wide {
    width: 174dp;
}

.hp-fill {
    display: block;
    height: 100%;
    width: 100%;
    background-color: #48bf7b;
}

.unit-orbs {
    position: absolute;
    left: 14dp;
    bottom: 34dp;
    display: inline-flex;
    gap: 5dp;
}

.unit-orb {
    width: 14dp;
    height: 14dp;
    background-color: rgba(28, 46, 72, 220);
    border: 1dp #d8ecf7;
    border-radius: 10dp;
}

.unit-orb.full {
    background-color: #3db7ff;
}

.unit-orb.gold {
    background-color: #f0cd4d;
}

.unit-orb.hidden {
    display: none;
}

.unit-orb.missing {
    background-color: rgba(240, 205, 77, 80);
    border-color: #f0cd4d;
    animation: 0.18s cubic-in-out infinite alternate orb-missing-pulse;
}

.unit-name {
    position: absolute;
    left: 14dp;
    top: 12dp;
    color: #eef2f8;
    font-size: 17dp;
    letter-spacing: 2dp;
}

.unit-power {
    position: absolute;
    right: 12dp;
    bottom: 30dp;
    color: #f4f5f7;
    font-size: 20dp;
    letter-spacing: 1dp;
}

.action-button {
    position: absolute;
    cursor: pointer;
    color: #f0ddad;
}

.action-button.disabled {
    opacity: 0.48;
}

.action-button-standard {
    right: 128dp;
    bottom: 74dp;
    width: 142dp;
    height: 142dp;
}

.action-button-skill {
    right: 32dp;
    bottom: 214dp;
    width: 96dp;
    height: 96dp;
}

.action-button-core {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(16, 20, 30, 126);
    border: 2dp #7d8496;
    border-radius: 999dp;
    box-shadow: 0 0 18dp rgba(255, 255, 255, 18);
}

.action-button-standard .action-button-core {
    border: 2dp #ceb57c;
    box-shadow: 0 0 22dp rgba(231, 201, 126, 26);
}

.action-button-icon {
    position: absolute;
    left: 50%;
    top: 50%;
}

.action-button-icon-single {
    width: 68dp;
    height: 68dp;
    margin-left: -34dp;
    margin-top: -34dp;
}

.action-button-icon-stacked {
    width: 44dp;
    height: 44dp;
    margin-left: -22dp;
    margin-top: -22dp;
}

.action-button-key {
    position: absolute;
    right: -6dp;
    top: -4dp;
    width: 38dp;
    height: 38dp;
    border-radius: 999dp;
    background-color: rgba(14, 12, 10, 230);
    border: 2dp #c7a95e;
    border-radius: 999dp;
    color: #f9e0a0;
    font-size: 20dp;
    line-height: 38dp;
    text-align: center;
}

.action-button-label {
    position: absolute;
    left: 50%;
    bottom: -32dp;
    width: 124dp;
    margin-left: -62dp;
    color: #e8d3a0;
    font-size: 14dp;
    letter-spacing: 2dp;
    text-align: center;
}

.battle-tutorial {
    position: absolute;
    left: 50%;
    bottom: 42dp;
    width: 92%;
    max-width: 1200dp;
    transform: translateX(-50%);
    opacity: 0;
    display: none;
    z-index: 10;
}

.battle-tutorial.visible {
    display: block;
    opacity: 1;
}

.battle-tutorial-layout {
    position: relative;
    display: flex;
    gap: 32dp;
    align-items: flex-end;
}

.battle-tutorial-speaker {
    position: absolute;
    left: 0;
    top: 0;
    display: inline-block;
    padding: 4dp 12dp 5dp 12dp;
    background-color: rgba(36, 44, 58, 236);
    border: 1dp #8f9bad;
    color: #f5f4f1;
    font-size: 18dp;
    line-height: 20dp;
    text-align: center;
    z-index: 1;
}

.battle-tutorial-card {
    position: relative;
    padding: 16dp 24dp 12dp 18dp;
    min-height: 160dp;
    background-color: rgba(5, 10, 18, 218);
    border: 1dp #d5dde8;
    overflow: hidden;
}

.battle-tutorial-portrait {
    position: relative;
    width: 126dp;
    height: 126dp;
    margin-top: auto;
    background-color: rgba(10, 14, 24, 230);
    overflow: hidden;
}

.battle-tutorial-copy {
    position: relative;
    flex: 1;
    min-height: 126dp;
    padding-top: 40dp;
    padding-bottom: 22dp;
}

.battle-tutorial-text {
    position: relative;
    color: #f5f4ef;
    font-size: 27dp;
    line-height: 34dp;
}

.battle-tutorial-dismiss-hint {
    position: absolute;
    right: 0;
    bottom: 0;
    color: rgba(245, 244, 239, 110);
    font-size: 14dp;
    letter-spacing: 1dp;
    text-align: right;
}

.battle-rhythm-lane {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 36dp;
    background-color: rgba(18, 30, 50, 210);
    border: 1dp #406188;
}

.battle-rhythm {
    position: absolute;
    left: 50%;
    bottom: 44dp;
    width: 90%;
    max-width: 384dp;
    min-height: 148dp;
    transform: translateX(-50%);
    padding: 14dp 18dp 54dp 18dp;
    background-color: rgba(11, 16, 28, 238);
    border: 1dp #f0cd4d;
    box-shadow: 0 0 30dp rgba(240, 205, 77, 28);
    opacity: 0;
    display: none;
    z-index: 20;
}

.battle-rhythm.visible {
    display: block;
    opacity: 1;
}

.battle-rhythm-kicker {
    display: block;
    color: #f0cd4d;
    font-size: 11dp;
    letter-spacing: 3dp;
}

.battle-rhythm-title {
    display: none;
}

.battle-rhythm-body {
    display: block;
    clear: both;
    margin-top: 10dp;
    color: #c3d1e4;
    font-size: 14dp;
    letter-spacing: 1dp;
}

.battle-rhythm .battle-rhythm-lane {
    position: absolute;
    left: 18dp;
    right: 18dp;
    bottom: 18dp;
}

.battle-rhythm-window {
    position: absolute;
    left: 206dp;
    top: 4dp;
    width: 62dp;
    height: 26dp;
    background-color: rgba(240, 205, 77, 70);
    border: 1dp #f0cd4d;
}

.battle-rhythm-pulse {
    position: absolute;
    left: 0;
    top: 2dp;
    width: 18dp;
    height: 30dp;
    background-color: #47d7ff;
    box-shadow: 0 0 16dp rgba(71, 215, 255, 62);
}

.battle-toast {
    position: absolute;
    left: 50%;
    bottom: 216dp;
    width: 360dp;
    margin-left: -180dp;
    padding: 12dp 18dp;
    background-color: rgba(12, 18, 30, 214);
    border: 1dp #c89b5b;
    color: #fff2cf;
    font-size: 18dp;
    letter-spacing: 1dp;
    text-align: center;
    opacity: 0;
    display: none;
}

.battle-toast.visible {
    display: block;
    animation: 0.16s cubic-in-out toast-rise;
    opacity: 1;
}

.battle-pause {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 8, 16, 160);
    z-index: 30;
}

.battle-pause.visible {
    display: block;
}

.battle-pause-shell {
    position: absolute;
    left: 0;
    right: 0;
    top: 92dp;
    width: 620dp;
    margin-left: auto;
    margin-right: auto;
    padding: 22dp 28dp 28dp 28dp;
    background-color: rgba(8, 16, 28, 230);
    border: 1dp #b36a38;
    box-shadow: 0 0 22dp rgba(255, 124, 61, 38);
    overflow: visible;
}

.battle-pause-kicker {
    display: block;
    width: 100%;
    color: #f0cd4d;
    font-size: 13dp;
    letter-spacing: 4dp;
}

.battle-pause-title {
    display: block;
    width: 100%;
    margin-top: 6dp;
    color: #fff3e2;
    font-size: 34dp;
    letter-spacing: 3dp;
}

.battle-pause-hint {
    display: block;
    width: 100%;
    margin-top: 8dp;
    color: #a9c5e6;
    font-size: 14dp;
    letter-spacing: 1dp;
    line-height: 20dp;
}

.battle-pause-menu {
    display: none;
    margin-top: 26dp;
}

.battle-pause-menu.visible {
    display: block;
}

.battle-pause-button {
    display: block;
    position: relative;
    height: 58dp;
    padding: 16dp 18dp 0 18dp;
    color: #d7e4f2;
    background-color: rgba(24, 38, 58, 210);
    border: 1dp #3f5e80;
    font-size: 18dp;
    letter-spacing: 2dp;
    line-height: 24dp;
}

.battle-pause-button + .battle-pause-button {
    margin-top: -1dp;
}

.battle-pause-button.selected {
    color: #121927;
    background-color: #f0cd4d;
    border: 1dp #fff2b3;
}

.battle-pause-button:hover {
    color: #121927;
    background-color: rgba(240, 205, 77, 220);
    border: 1dp #fff2b3;
}

.battle-pause-settings {
    display: none;
    margin-top: 26dp;
}

.battle-pause-settings.visible {
    display: block;
}

.battle-settings-row {
    position: relative;
    display: block;
    height: 64dp;
    padding: 0;
    background-color: rgba(18, 30, 48, 220);
    border: 1dp #35506f;
}

.battle-settings-row + .battle-settings-row {
    margin-top: -1dp;
}

.battle-settings-row.selected {
    background-color: #f0cd4d;
    border: 1dp #fff2b3;
}

.battle-settings-row:hover {
    background-color: rgba(240, 205, 77, 220);
    border: 1dp #fff2b3;
}

#battle-settings-row-voice,
#battle-settings-row-text {
    height: 84dp;
}

.battle-settings-label {
    position: absolute;
    left: 18dp;
    top: 17dp;
    color: #d9e7f6;
    font-size: 17dp;
    letter-spacing: 2dp;
}

.battle-settings-row.selected .battle-settings-label {
    color: #101724;
}

.battle-settings-row:hover .battle-settings-label {
    color: #101724;
}

.battle-settings-value {
    position: absolute;
    right: 18dp;
    top: 18dp;
    color: #ffffff;
    font-size: 16dp;
    letter-spacing: 1dp;
    text-align: right;
}

.battle-settings-row.selected .battle-settings-value {
    color: #101724;
}

.battle-settings-row:hover .battle-settings-value {
    color: #101724;
}

.battle-settings-slider {
    position: absolute;
    left: 18dp;
    right: 18dp;
    bottom: 12dp;
    height: 12dp;
}

input.battle-settings-slider {
    width: auto;
    background: transparent;
}

input.battle-settings-slider slidertrack {
    margin-top: 4dp;
    height: 4dp;
    background-color: #273a55;
    border: 0;
}

input.battle-settings-slider sliderprogress {
    margin-top: 4dp;
    height: 4dp;
    background-color: #f0cd4d;
}

.battle-settings-row.selected input.battle-settings-slider slidertrack,
.battle-settings-row:hover input.battle-settings-slider slidertrack {
    background-color: rgba(255, 255, 255, 38);
}

.battle-settings-row.selected input.battle-settings-slider sliderprogress,
.battle-settings-row:hover input.battle-settings-slider sliderprogress {
    background-color: #fff9ec;
}

input.battle-settings-slider sliderbar {
    width: 8dp;
    height: 12dp;
    margin-left: -4dp;
    margin-right: -4dp;
    margin-top: 0;
    background-color: #f0cd4d;
    border: 0;
    border-radius: 0;
}

.battle-settings-row.selected input.battle-settings-slider sliderbar,
.battle-settings-row:hover input.battle-settings-slider sliderbar {
    background-color: #fffdf7;
}

input.battle-settings-slider sliderbar:hover {
    background-color: #ffe17f;
}

input.battle-settings-slider sliderbar:active {
    background-color: #fff1b2;
}

input.battle-settings-slider sliderarrowdec,
input.battle-settings-slider sliderarrowinc {
    display: none;
}
