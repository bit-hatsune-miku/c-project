@keyframes battle-vs-shake {
    from {
        transform: translateX(0dp);
    }
    25% {
        transform: translateX(-7dp);
    }
    50% {
        transform: translateX(8dp);
    }
    75% {
        transform: translateX(-5dp);
    }
    to {
        transform: translateX(0dp);
    }
}

.battle-vs-intro {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    width: 1280dp;
    height: 720dp;
    z-index: 90;
    pointer-events: none;
}

.battle-vs-intro.active {
    display: block;
}

.battle-vs-intro-void {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: #000000;
    opacity: 1;
    transition: opacity 0.26s linear;
}

.battle-vs-intro.void-cleared .battle-vs-intro-void {
    opacity: 0;
}

.battle-vs-intro-splitter {
    position: absolute;
    left: 50%;
    top: -700dp;
    width: 88dp;
    height: 2200dp;
    opacity: 0;
    background-color: #ffb1cc;
    decorator: linear-gradient(to bottom, #fff0f6 0%, #ffb1cc 100%);
    box-shadow: 0 0 14dp rgba(255, 192, 216, 76), 0 0 40dp rgba(255, 173, 206, 62);
    transform: translateX(-50%) rotate(0deg) scaleY(0);
    transform-origin: 50% 50%;
}

.battle-vs-intro.split-dropping .battle-vs-intro-splitter {
    opacity: 1;
    transform: translateX(-50%) rotate(0deg) scaleY(1);
    transition: opacity 0.09s linear, transform 0.26s cubic-out;
}

.battle-vs-intro.split-angled .battle-vs-intro-splitter {
    opacity: 1;
    transform: translateX(-50%) rotate(18deg) scaleY(1);
    transition: transform 0.22s cubic-out;
}

.battle-vs-intro.split-fading .battle-vs-intro-splitter {
    opacity: 0;
    transition: opacity 0.22s linear;
}

.battle-vs-card {
    position: absolute;
    opacity: 0.98;
}

.battle-vs-card.left {
    left: -222dp;
    top: -120dp;
    width: 920dp;
    height: 1080dp;
    transform: translate(-620dp, 560dp);
}

.battle-vs-card.right {
    right: -226dp;
    top: -120dp;
    width: 920dp;
    height: 1080dp;
    transform: translate(620dp, -560dp);
}

.battle-vs-intro.left-landed .battle-vs-card.left {
    transform: translate(0dp, 0dp);
    transition: transform 0.46s cubic-out;
}

.battle-vs-intro.right-landed .battle-vs-card.right {
    transform: translate(0dp, 0dp);
    transition: transform 0.46s cubic-out;
}

.battle-vs-intro.exiting .battle-vs-card.left {
    transform: translate(-860dp, 0dp);
    transition: transform 0.50s cubic-out;
}

.battle-vs-intro.exiting .battle-vs-card.right {
    transform: translate(860dp, 0dp);
    transition: transform 0.50s cubic-out;
}

