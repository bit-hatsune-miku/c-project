body {
    margin: 0;
    width: 100%;
    height: 100%;
    color: #f5efe2;
    background-color: transparent;
    font-family: "DejaVu Sans";
}

#stage {
    position: relative;
    width: 100%;
    height: 100%;
}

@keyframes active-turn-bounce {
    from {
        transform: translateX(0px);
    }
    to {
        transform: translateX(12px);
    }
}

@keyframes orb-missing-pulse {
    from {
        transform: scale(1.0);
        opacity: 0.45;
    }
    to {
        transform: scale(1.14);
        opacity: 1.0;
    }
}

@keyframes toast-rise {
    from {
        transform: translateY(10px);
        opacity: 0;
    }
    to {
        transform: translateY(0px);
        opacity: 1;
    }
}

.boss-shell {
    position: absolute;
    top: 26px;
    left: 0;
    right: 0;
    width: 620px;
    height: 74px;
    margin-left: auto;
    margin-right: auto;
    background-color: rgba(8, 14, 24, 214);
    border: 1px #b36a38;
    box-shadow: 0 0 18px rgba(255, 124, 61, 52);
    overflow: hidden;
}

.boss-name {
    position: absolute;
    left: 26px;
    top: 14px;
    color: #fff5ec;
    font-size: 29px;
    letter-spacing: 1px;
}

.boss-percent {
    position: absolute;
    right: 24px;
    top: 16px;
    color: #fff1de;
    font-size: 18px;
    letter-spacing: 1px;
}

.boss-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background-color: rgba(197, 77, 72, 90);
}

.boss-orbs {
    position: absolute;
    left: 26px;
    bottom: 12px;
    display: inline-flex;
    gap: 6px;
}

.boss-orb {
    width: 10px;
    height: 10px;
    background-color: rgba(28, 46, 72, 220);
    border: 1px #d8ecf7;
    border-radius: 10px;
}

.boss-orb.full {
    background-color: #3db7ff;
}

.boss-orb.gold {
    background-color: #f0cd4d;
}

.boss-orb.hidden {
    display: none;
}

.turn-stack {
    position: absolute;
    top: 124px;
    left: 26px;
    width: 112px;
    height: 390px;
}

.turn-card {
    position: absolute;
    left: 10px;
    width: 78px;
    height: 54px;
    background-color: rgba(10, 20, 33, 228);
    border: 1px #294561;
    border-radius: 8px;
    box-shadow: 0 0 10px rgba(73, 121, 173, 22);
    overflow: hidden;
}

.turn-card.active {
    border-color: #ff9d57;
    box-shadow: 0 0 14px rgba(255, 157, 87, 46);
    animation: 0.95s cubic-in-out infinite alternate active-turn-bounce;
}

.turn-card.boss {
    border-color: #8a3e3a;
}

.turn-card-1 {
    top: 18px;
}

.turn-card-2 {
    top: 84px;
}

.turn-card-3 {
    top: 150px;
}

.turn-card-4 {
    top: 216px;
}

.turn-card-5 {
    top: 282px;
}

.turn-card-accent {
    position: absolute;
    left: 0;
    top: 10px;
    width: 4px;
    height: 34px;
    background-color: #54bfdc;
}

.boss-accent {
    background-color: #dc6154;
}

.turn-portrait {
    position: absolute;
    left: 9px;
    top: -3px;
    width: 62px;
    height: 62px;
}

.party-rack {
    position: absolute;
    left: 32px;
    bottom: 28px;
    width: 900px;
    height: 152px;
}

.unit-card {
    position: absolute;
    width: 206px;
    height: 138px;
    background-color: rgba(9, 15, 25, 120);
    border: 0;
    overflow: hidden;
}

.unit-card.focus {
    box-shadow: 0 0 28px rgba(255, 157, 87, 70);
}

.unit-card.ult-ready {
    box-shadow: 0 0 34px rgba(242, 205, 77, 110);
    background-color: rgba(34, 24, 10, 132);
}

.unit-card.ghost {
    opacity: 0.96;
}

.unit-card-1 {
    left: 0;
    top: 0;
}

.unit-card-2 {
    left: 226px;
    top: 0;
}

.unit-card-3 {
    left: 452px;
    top: 0;
}

.unit-card-4 {
    left: 678px;
    top: 0;
}

.unit-portrait {
    position: absolute;
    left: 0;
    top: 0;
    width: 138px;
    height: 138px;
}

.unit-fade-left {
    position: absolute;
    left: 0;
    top: 0;
    width: 52px;
    height: 138px;
    decorator: linear-gradient(to right, #070b14eb, #070b1400) border-box;
}

.unit-card.ult-ready .unit-fade-left {
    decorator: linear-gradient(to right, #8f6719f2, #8f671900) border-box;
}

.unit-fade-right {
    position: absolute;
    right: 0;
    top: 0;
    width: 52px;
    height: 138px;
    decorator: linear-gradient(to left, #070b14eb, #070b1400) border-box;
}

.unit-card.ult-ready .unit-fade-right {
    decorator: linear-gradient(to left, #8f6719f2, #8f671900) border-box;
}

.unit-fade-bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 58px;
    decorator: linear-gradient(to top, #070b14e8, #070b1400) border-box;
}

.unit-card.ult-ready .unit-fade-bottom {
    decorator: linear-gradient(to top, #8f6719ed, #8f671900) border-box;
}

.hp-track {
    position: absolute;
    left: 14px;
    bottom: 12px;
    width: 174px;
    height: 9px;
    background-color: #1c2531;
    border: 1px #2f4868;
}

.hp-track-wide {
    width: 174px;
}

.hp-fill {
    display: block;
    height: 100%;
    width: 100%;
    background-color: #48bf7b;
}

.unit-orbs {
    position: absolute;
    left: 14px;
    bottom: 34px;
    display: inline-flex;
    gap: 5px;
}

.unit-orb {
    width: 14px;
    height: 14px;
    background-color: rgba(28, 46, 72, 220);
    border: 1px #d8ecf7;
    border-radius: 10px;
}

.unit-orb.full {
    background-color: #3db7ff;
}

.unit-orb.gold {
    background-color: #f0cd4d;
}

.unit-orb.hidden {
    display: none;
}

.unit-orb.missing {
    background-color: rgba(240, 205, 77, 80);
    border-color: #f0cd4d;
    animation: 0.18s cubic-in-out infinite alternate orb-missing-pulse;
}

.unit-name {
    position: absolute;
    left: 14px;
    top: 12px;
    color: #eef2f8;
    font-size: 17px;
    letter-spacing: 2px;
}

.unit-power {
    position: absolute;
    right: 12px;
    bottom: 30px;
    color: #f4f5f7;
    font-size: 20px;
    letter-spacing: 1px;
}

.action-button {
    position: absolute;
    cursor: pointer;
    color: #f0ddad;
}

.action-button.disabled {
    opacity: 0.48;
}

.action-button-standard {
    right: 128px;
    bottom: 74px;
    width: 142px;
    height: 142px;
}

.action-button-skill {
    right: 32px;
    bottom: 214px;
    width: 96px;
    height: 96px;
}

.action-button-core {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(16, 20, 30, 126);
    border: 2px #7d8496;
    border-radius: 999px;
    box-shadow: 0 0 18px rgba(255, 255, 255, 18);
}

.action-button-standard .action-button-core {
    border: 2px #ceb57c;
    box-shadow: 0 0 22px rgba(231, 201, 126, 26);
}

.action-button-icon {
    position: absolute;
    left: 50%;
    top: 50%;
}

.action-button-icon-single {
    width: 68px;
    height: 68px;
    margin-left: -34px;
    margin-top: -34px;
}

.action-button-icon-stacked {
    width: 44px;
    height: 44px;
    margin-left: -22px;
    margin-top: -22px;
}

.action-button-key {
    position: absolute;
    right: -6px;
    top: -4px;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    background-color: rgba(14, 12, 10, 230);
    border: 2px #c7a95e;
    border-radius: 999px;
    color: #f9e0a0;
    font-size: 20px;
    line-height: 38px;
    text-align: center;
}

.action-button-label {
    position: absolute;
    left: 50%;
    bottom: -32px;
    width: 124px;
    margin-left: -62px;
    color: #e8d3a0;
    font-size: 14px;
    letter-spacing: 2px;
    text-align: center;
}

.battle-tutorial {
    position: absolute;
    left: 50%;
    bottom: 42px;
    width: 1200px;
    height: 198px;
    margin-left: -600px;
    opacity: 0;
    display: none;
}

.battle-tutorial.visible {
    display: block;
    opacity: 1;
}

.battle-tutorial-speaker {
    position: absolute;
    top: 0;
    left: 50%;
    width: 220px;
    margin-left: -110px;
    color: #f5f4f1;
    font-size: 22px;
    text-align: center;
}

.battle-tutorial-card {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 160px;
    background-color: rgba(5, 10, 18, 218);
    border: 1px #d5dde8;
    overflow: hidden;
}

.battle-tutorial-portrait {
    position: absolute;
    left: 18px;
    bottom: 18px;
    width: 126px;
    height: 126px;
    background-color: rgba(10, 14, 24, 230);
    overflow: hidden;
}

.battle-tutorial-copy {
    position: absolute;
    left: 176px;
    right: 24px;
    top: 22px;
    bottom: 22px;
}

.battle-tutorial-text {
    color: #f5f4ef;
    font-size: 27px;
    line-height: 34px;
}

.battle-rhythm-lane {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 36px;
    background-color: rgba(18, 30, 50, 210);
    border: 1px #406188;
}

.battle-rhythm {
    position: absolute;
    left: 50%;
    bottom: 44px;
    width: 384px;
    height: 148px;
    margin-left: -192px;
    padding: 14px 18px;
    background-color: rgba(11, 16, 28, 238);
    border: 1px #f0cd4d;
    box-shadow: 0 0 30px rgba(240, 205, 77, 28);
    opacity: 0;
    display: none;
}

.battle-rhythm.visible {
    display: block;
    opacity: 1;
}

.battle-rhythm-kicker {
    display: block;
    color: #f0cd4d;
    font-size: 11px;
    letter-spacing: 3px;
}

.battle-rhythm-title {
    display: none;
}

.battle-rhythm-body {
    display: block;
    clear: both;
    margin-top: 10px;
    color: #c3d1e4;
    font-size: 14px;
    letter-spacing: 1px;
}

.battle-rhythm .battle-rhythm-lane {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 18px;
}

.battle-rhythm-window {
    position: absolute;
    left: 206px;
    top: 4px;
    width: 62px;
    height: 26px;
    background-color: rgba(240, 205, 77, 70);
    border: 1px #f0cd4d;
}

.battle-rhythm-pulse {
    position: absolute;
    left: 0;
    top: 2px;
    width: 18px;
    height: 30px;
    background-color: #47d7ff;
    box-shadow: 0 0 16px rgba(71, 215, 255, 62);
}

.battle-toast {
    position: absolute;
    left: 50%;
    bottom: 216px;
    width: 360px;
    margin-left: -180px;
    padding: 12px 18px;
    background-color: rgba(12, 18, 30, 214);
    border: 1px #c89b5b;
    color: #fff2cf;
    font-size: 18px;
    letter-spacing: 1px;
    text-align: center;
    opacity: 0;
    display: none;
}

.battle-toast.visible {
    display: block;
    animation: 0.16s cubic-in-out toast-rise;
    opacity: 1;
}

.battle-pause {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 8, 16, 160);
}

.battle-pause.visible {
    display: block;
}

.battle-pause-shell {
    position: absolute;
    left: 0;
    right: 0;
    top: 92px;
    width: 620px;
    margin-left: auto;
    margin-right: auto;
    padding: 22px 28px 28px 28px;
    background-color: rgba(8, 16, 28, 230);
    border: 1px #b36a38;
    box-shadow: 0 0 22px rgba(255, 124, 61, 38);
    overflow: visible;
}

.battle-pause-kicker {
    display: block;
    width: 100%;
    color: #f0cd4d;
    font-size: 13px;
    letter-spacing: 4px;
}

.battle-pause-title {
    display: block;
    width: 100%;
    margin-top: 6px;
    color: #fff3e2;
    font-size: 34px;
    letter-spacing: 3px;
}

.battle-pause-hint {
    display: block;
    width: 100%;
    margin-top: 8px;
    color: #a9c5e6;
    font-size: 14px;
    letter-spacing: 1px;
    line-height: 20px;
}

.battle-pause-menu {
    display: none;
    margin-top: 26px;
}

.battle-pause-menu.visible {
    display: block;
}

.battle-pause-button {
    display: block;
    position: relative;
    height: 58px;
    padding: 16px 18px 0 18px;
    color: #d7e4f2;
    background-color: rgba(24, 38, 58, 210);
    border: 1px #3f5e80;
    font-size: 18px;
    letter-spacing: 2px;
    line-height: 24px;
}

.battle-pause-button + .battle-pause-button {
    margin-top: -1px;
}

.battle-pause-button.selected {
    color: #121927;
    background-color: #f0cd4d;
    border: 1px #fff2b3;
}

.battle-pause-button:hover {
    color: #121927;
    background-color: rgba(240, 205, 77, 220);
    border: 1px #fff2b3;
}

.battle-pause-settings {
    display: none;
    margin-top: 26px;
}

.battle-pause-settings.visible {
    display: block;
}

.battle-settings-row {
    position: relative;
    display: block;
    height: 64px;
    padding: 0;
    background-color: rgba(18, 30, 48, 220);
    border: 1px #35506f;
}

.battle-settings-row + .battle-settings-row {
    margin-top: -1px;
}

.battle-settings-row.selected {
    background-color: #f0cd4d;
    border: 1px #fff2b3;
}

.battle-settings-row:hover {
    background-color: rgba(240, 205, 77, 220);
    border: 1px #fff2b3;
}

#battle-settings-row-voice,
#battle-settings-row-text {
    height: 84px;
}

.battle-settings-label {
    position: absolute;
    left: 18px;
    top: 17px;
    color: #d9e7f6;
    font-size: 17px;
    letter-spacing: 2px;
}

.battle-settings-row.selected .battle-settings-label {
    color: #101724;
}

.battle-settings-row:hover .battle-settings-label {
    color: #101724;
}

.battle-settings-value {
    position: absolute;
    right: 18px;
    top: 18px;
    color: #ffffff;
    font-size: 16px;
    letter-spacing: 1px;
    text-align: right;
}

.battle-settings-row.selected .battle-settings-value {
    color: #101724;
}

.battle-settings-row:hover .battle-settings-value {
    color: #101724;
}

.battle-settings-slider {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 12px;
    height: 12px;
}

input.battle-settings-slider {
    width: auto;
    background: transparent;
}

input.battle-settings-slider slidertrack {
    margin-top: 4px;
    height: 4px;
    background-color: #273a55;
    border: 0;
}

input.battle-settings-slider sliderprogress {
    margin-top: 4px;
    height: 4px;
    background-color: #f0cd4d;
}

.battle-settings-row.selected input.battle-settings-slider slidertrack,
.battle-settings-row:hover input.battle-settings-slider slidertrack {
    background-color: rgba(255, 255, 255, 38);
}

.battle-settings-row.selected input.battle-settings-slider sliderprogress,
.battle-settings-row:hover input.battle-settings-slider sliderprogress {
    background-color: #fff9ec;
}

input.battle-settings-slider sliderbar {
    width: 8px;
    height: 12px;
    margin-left: -4px;
    margin-right: -4px;
    margin-top: 0;
    background-color: #f0cd4d;
    border: 0;
    border-radius: 0;
}

.battle-settings-row.selected input.battle-settings-slider sliderbar,
.battle-settings-row:hover input.battle-settings-slider sliderbar {
    background-color: #fffdf7;
}

input.battle-settings-slider sliderbar:hover {
    background-color: #ffe17f;
}

input.battle-settings-slider sliderbar:active {
    background-color: #fff1b2;
}

input.battle-settings-slider sliderarrowdec,
input.battle-settings-slider sliderarrowinc {
    display: none;
}
