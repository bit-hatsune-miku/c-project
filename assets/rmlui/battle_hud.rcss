.battle-vs-cluster {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    z-index: 60;
    opacity: 1;
    transition: opacity 0.12s linear;
}

.battle-vs-intro.vs-hidden .battle-vs-cluster {
    opacity: 0;
}

.battle-vs-intro.vs-shaking .battle-vs-cluster {
    animation: battle-vs-shake 0.18s linear 2;
}

.battle-vs-hit-anchor {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
}

.battle-vs-hit-anchor.v {
    z-index: 1;
    transform: translate(-118dp, -156dp);
}

.battle-vs-hit-anchor.s {
    z-index: 2;
    transform: translate(-10dp, -56dp);
}

.battle-vs-letter {
    position: absolute;
    left: 0;
    top: 0;
    font-size: 214dp;
    line-height: 1;
    font-weight: bold;
    opacity: 0;
}

.battle-vs-letter.v {
    color: #ffffff;
    font-effect: shadow(0 18dp rgba(0, 0, 0, 108));
}

.battle-vs-letter.s {
    color: #ff8fb8;
    font-effect: shadow(0 18dp rgba(0, 0, 0, 108));
}

.battle-toast {
    position: absolute;
    left: 50%;
    bottom: 186dp;
    width: 480dp;
    height: 40dp;
    margin-left: -240dp;
    background-color: rgba(23, 20, 31, 230);
    border-radius: 999dp;
    color: rgba(255, 255, 255, 232);
    font-size: 12dp;
    font-weight: bold;
    letter-spacing: 1dp;
    line-height: 40dp;
    text-align: center;
    opacity: 0;
    display: none;
}

.battle-toast.visible {
    display: block;
    animation: 0.16s cubic-in-out toast-rise;
    opacity: 1;
}

.battle-pause {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 8, 16, 160);
    z-index: 30;
}

.battle-pause.visible {
    display: block;
}

.battle-pause-shell {
    position: absolute;
    left: 0;
    right: 0;
    top: 92dp;
    width: 620dp;
    margin-left: auto;
    margin-right: auto;
    padding: 28dp 28dp 26dp;
    background-color: rgba(8, 12, 18, 236);
    border: 1dp #c89b5b;
    box-shadow: 0 0 22dp rgba(255, 124, 61, 38);
}

.battle-pause-shell.settings-open {
    width: 760dp;
}

.battle-pause-kicker {
    color: #c89b5b;
    font-size: 12dp;
    letter-spacing: 3dp;
}

.battle-pause-title {
    margin-top: 8dp;
    color: #fff4de;
    font-size: 32dp;
    letter-spacing: 2dp;
}

.battle-pause-hint {
    margin-top: 10dp;
    color: rgba(244, 236, 223, 142);
    font-size: 13dp;
    letter-spacing: 1dp;
}

.battle-pause-menu,
.battle-pause-settings {
    display: none;
    margin-top: 24dp;
}

.battle-pause-menu.visible,
.battle-pause-settings.visible {
    display: block;
}

.battle-pause-button,
.battle-settings-row {
    position: relative;
    margin-top: 12dp;
    padding: 14dp 18dp;
    background-color: rgba(20, 26, 38, 214);
    border: 1dp #415974;
    color: #dfe8f2;
    font-size: 18dp;
    letter-spacing: 1dp;
}

.battle-pause-button.selected,
.battle-settings-row.selected {
    border-color: #f0cd4d;
    box-shadow: 0 0 16dp rgba(240, 205, 77, 24);
    color: #fff3c9;
}

.battle-settings-label {
    font-size: 16dp;
    letter-spacing: 2dp;
}

.battle-settings-value {
    position: absolute;
    right: 18dp;
    top: 14dp;
    color: #f0cd4d;
    font-size: 16dp;
}

.battle-settings-slider {
    width: 100%;
    margin-top: 18dp;
}
