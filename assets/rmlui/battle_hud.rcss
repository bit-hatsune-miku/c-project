body {
    margin: 0;
    width: 100%;
    height: 100%;
    color: #fff7fb;
    background-color: transparent;
    font-family: "Space Mono";
    position: relative;
}

#hud-root {
    position: relative;
    width: 100%;
    height: 100%;
}

#hud-edge-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}

#safe-stage {
    position: absolute;
    left: 0;
    top: 0;
    width: 1280px;
    height: 720px;
}

.battle-combo {
    position: absolute;
    right: 18dp;
    top: 18dp;
    width: 116dp;
    padding: 8dp 10dp 10dp;
    background-color: rgba(18, 14, 24, 176);
    border: 1dp rgba(255, 255, 255, 24);
    border-radius: 16dp;
    box-shadow: 0 12dp 24dp rgba(0, 0, 0, 22);
}

.battle-combo-count {
    text-align: right;
    color: #fff8fb;
    font-size: 30dp;
    font-weight: bold;
    letter-spacing: 1dp;
    line-height: 1;
}

.battle-combo-bonus {
    margin-top: 6dp;
    text-align: right;
    color: rgba(255, 244, 249, 214);
    font-size: 10dp;
    font-weight: bold;
    letter-spacing: 1dp;
}

.battle-combo-meter {
    position: relative;
    margin-top: 8dp;
    width: 100%;
    height: 6dp;
    background-color: rgba(255, 255, 255, 18);
    border-radius: 999dp;
    overflow: hidden;
}

.battle-combo-fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 0%;
    height: 6dp;
    background-color: #ff67b6;
    decorator: linear-gradient(to right, #ff67b6 0%, #f4c06d 52%, #6acff6 100%);
    border-radius: 999dp;
    box-shadow: 0 0 12dp rgba(255, 103, 182, 70);
}

.battle-judgement {
    position: absolute;
    right: 42dp;
    top: 304dp;
    width: 430dp;
    opacity: 0;
    display: none;
    text-align: right;
    pointer-events: none;
}

.battle-judgement-word {
    width: 100%;
    height: 86dp;
    line-height: 1;
    white-space: nowrap;
}

.battle-judgement-letter {
    display: inline-block;
    margin-left: 6dp;
    font-size: 72dp;
    line-height: 82dp;
    font-weight: bold;
    letter-spacing: 2dp;
    text-transform: uppercase;
}

.battle-judgement-space {
    display: inline-block;
    width: 18dp;
}

.battle-judgement-reward {
    display: none;
    margin-top: 2dp;
    color: rgba(255, 248, 251, 226);
    font-size: 20dp;
    font-weight: bold;
    letter-spacing: 2dp;
    text-transform: uppercase;
}

.battle-judgement.perfect .battle-judgement-letter {
    font-effect: outline(2dp #541237), shadow(0 10dp rgba(84, 18, 55, 132));
}

.battle-judgement.good .battle-judgement-letter {
    font-effect: outline(2dp #0d4230), shadow(0 10dp rgba(13, 66, 48, 132));
}

.battle-judgement.okay .battle-judgement-letter {
    font-effect: outline(2dp #653d0d), shadow(0 10dp rgba(101, 61, 13, 132));
}

.battle-judgement.flop .battle-judgement-letter {
    font-effect: outline(2dp #6a1621), shadow(0 10dp rgba(106, 22, 33, 132));
}

.battle-judgement.perfect .battle-judgement-reward {
    font-effect: outline(1dp #541237);
}

.battle-judgement.good .battle-judgement-reward {
    font-effect: outline(1dp #0d4230);
}

.battle-judgement.okay .battle-judgement-reward {
    font-effect: outline(1dp #653d0d);
}

.battle-judgement.flop .battle-judgement-reward {
    font-effect: outline(1dp #6a1621);
}

@keyframes active-turn-bounce {
    from {
        transform: translateX(0dp);
    }
    50% {
        transform: translateX(12dp);
    }
    to {
        transform: translateX(0dp);
    }
}

@keyframes unit-hit-shake {
    from {
        transform: translateX(0dp);
    }
    20% {
        transform: translateX(-6dp);
    }
    40% {
        transform: translateX(5dp);
    }
    60% {
        transform: translateX(-4dp);
    }
    80% {
        transform: translateX(2dp);
    }
    to {
        transform: translateX(0dp);
    }
}

@keyframes toast-rise {
    from {
        transform: translateY(10dp);
        opacity: 0;
    }
    to {
        transform: translateY(0dp);
        opacity: 1;
    }
}


.turn-rail {
    position: absolute;
    left: 12dp;
    top: 14dp;
    width: 86dp;
    height: 330dp;
}

.turn-card {
    position: absolute;
    left: 0;
    width: 72dp;
    height: 54dp;
}

#turn-card-1 { top: 0dp; }
#turn-card-2 { top: 62dp; }
#turn-card-3 { top: 124dp; }
#turn-card-4 { top: 186dp; }
#turn-card-5 { top: 248dp; }

.turn-card-shell {
    position: absolute;
    left: 0;
    top: 0;
    width: 72dp;
    height: 54dp;
    background-color: rgba(255, 250, 253, 232);
    border: 1dp rgba(23, 20, 31, 42);
    border-radius: 16dp;
    transform: skewX(-18deg);
    box-shadow: 0 10dp 22dp rgba(0, 0, 0, 22);
}

.turn-card-stripe {
    position: absolute;
    left: 8dp;
    top: 10dp;
    width: 4dp;
    height: 32dp;
    background-color: rgba(255, 103, 182, 132);
    border-radius: 999dp;
}

.turn-card-inner {
    position: absolute;
    left: 0;
    top: 0;
    width: 72dp;
    height: 54dp;
    transform: skewX(18deg);
}

.turn-portrait-frame {
    position: absolute;
    left: 8dp;
    top: 7dp;
    width: 54dp;
    height: 40dp;
    border-radius: 11dp;
    background-color: rgba(23, 20, 31, 18);
    border: 1dp rgba(23, 20, 31, 18);
    overflow: hidden;
}

.turn-portrait {
    position: absolute;
    left: 0;
    top: 0;
    width: 54dp;
    height: 40dp;
    background-color: transparent;
}

.turn-badge {
    position: absolute;
    right: -2dp;
    bottom: -2dp;
    width: 30dp;
    height: 16dp;
    background-color: rgba(23, 20, 31, 234);
    border: 1dp rgba(255, 255, 255, 34);
    border-radius: 9dp;
    transform: skewX(-18deg);
}

.turn-badge-value {
    position: absolute;
    left: 7dp;
    top: 3dp;
    font-size: 9dp;
    font-weight: bold;
    color: #fff7fb;
    transform: skewX(18deg);
}

.turn-card.active {
    animation: active-turn-bounce 0.92s cubic-in-out infinite;
}

.turn-card.active .turn-card-shell {
    border: 2dp #ff67b6;
    box-shadow: 0 12dp 28dp rgba(255, 103, 182, 28);
}

.turn-card.active .turn-card-stripe {
    background-color: #ff67b6;
}

.turn-card.boss .turn-card-shell {
    background-color: rgba(255, 242, 244, 236);
    border: 1dp rgba(236, 95, 102, 58);
}

.turn-card.boss .turn-card-stripe {
    background-color: rgba(236, 95, 102, 158);
}

.turn-card.boss.active .turn-card-shell {
    border: 2dp rgba(236, 95, 102, 214);
    box-shadow: 0 12dp 28dp rgba(236, 95, 102, 26);
}

.boss-band {
    position: absolute;
    left: 110dp;
    right: 24dp;
    top: 8dp;
    height: 80dp;
}

.boss-name {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    padding-left: 18dp;
    padding-right: 18dp;
    text-align: center;
    color: #fff8fb;
    font-size: 28dp;
    font-weight: bold;
    letter-spacing: 1dp;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: clip;
}

.boss-meter-shell {
    position: absolute;
    left: 50%;
    top: 38dp;
    width: 540dp;
    height: 34dp;
    margin-left: -270dp;
    background-color: rgba(255, 250, 253, 238);
    border: 1dp rgba(23, 20, 31, 34);
    border-radius: 16dp;
    transform: skewX(-18deg);
    box-shadow: 0 12dp 26dp rgba(0, 0, 0, 24);
}

.boss-meter-lane {
    position: absolute;
    left: 3dp;
    top: 3dp;
    width: 534dp;
    height: 28dp;
    background-color: rgba(23, 20, 31, 24);
    border: 1dp rgba(23, 20, 31, 18);
    border-radius: 12dp;
    transform: skewX(18deg);
    overflow: hidden;
}

.boss-meter-trail {
    position: absolute;
    left: 0;
    top: 0;
    height: 28dp;
    width: 100%;
    background-color: rgba(120, 26, 42, 0.82);
    decorator: linear-gradient(to right, rgba(162, 54, 74, 0.90), rgba(120, 26, 42, 0.86), rgba(90, 18, 30, 0.94)) border-box;
    opacity: 0;
}

.boss-meter-fill {
    position: absolute;
    left: 0;
    top: 0;
    height: 28dp;
    width: 100%;
    background-color: #ec5f66;
    decorator: linear-gradient(to right, rgba(255, 151, 145, 0.94), rgba(236, 95, 102, 0.94), rgba(210, 64, 85, 0.98)) border-box;
}

.boss-meter-readout {
    position: absolute;
    left: 18dp;
    right: 18dp;
    top: 7dp;
    height: 14dp;
    color: rgba(23, 20, 31, 214);
    font-size: 11dp;
    font-weight: bold;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.boss-readout {
    position: absolute;
    left: 0;
    top: 0;
}

.boss-percent {
    position: absolute;
    right: 0;
    top: 0;
}

.boss-hit-flash {
    position: absolute;
    left: 50%;
    top: 32dp;
    width: 552dp;
    height: 46dp;
    margin-left: -276dp;
    background-color: rgba(255, 96, 116, 0);
    border-radius: 20dp;
    opacity: 0;
}

.boss-band.hit .boss-meter-shell {
    box-shadow: 0 12dp 26dp rgba(0, 0, 0, 24), 0 0 34dp rgba(236, 95, 102, 28);
}

.boss-band.hit .boss-hit-flash {
    opacity: 1;
    background-color: rgba(255, 96, 116, 34);
}

.party-rack {
    position: absolute;
    left: 16dp;
    bottom: 12dp;
    width: 816dp;
    height: 146dp;
}

.unit-card {
    position: absolute;
    bottom: 0;
    width: 186dp;
    height: 132dp;
}

#unit-card-1 { left: 0dp; }
#unit-card-2 { left: 198dp; }
#unit-card-3 { left: 396dp; }
#unit-card-4 { left: 594dp; }

.unit-card.active {
    transform: translateY(-6dp);
}

.unit-card.ghost {
    opacity: 0.56;
}

.unit-ult {
    position: absolute;
    right: 10dp;
    bottom: 34dp;
    width: 88dp;
    height: 88dp;
    background-color: rgba(23, 20, 31, 30);
    border: 1dp rgba(23, 20, 31, 40);
    border-radius: 999dp;
    overflow: hidden;
    z-index: 1;
    box-shadow: 0 12dp 20dp rgba(0, 0, 0, 16);
}

.unit-ult-sheen {
    position: absolute;
    left: -30dp;
    top: -12dp;
    width: 26dp;
    height: 112dp;
    background-color: rgba(255, 255, 255, 164);
    transform: skewX(-18deg) rotate(10deg);
    opacity: 0;
    z-index: 2;
}

.unit-ult-fill {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 88dp;
    height: 0dp;
    background-color: rgba(255, 103, 182, 204);
    decorator: linear-gradient(to bottom, rgba(255, 148, 192, 0.96), rgba(255, 103, 182, 0.94), rgba(248, 183, 96, 0.90)) border-box;
}

.unit-ult-rim {
    position: absolute;
    left: 6dp;
    top: 6dp;
    width: 74dp;
    height: 74dp;
    border: 1dp rgba(255, 255, 255, 40);
    border-radius: 999dp;
}

.unit-ult-core {
    position: absolute;
    left: 18dp;
    top: 28dp;
    width: 52dp;
    height: 16dp;
    color: rgba(23, 20, 31, 224);
    font-size: 10dp;
    font-weight: bold;
    letter-spacing: 1dp;
    text-align: center;
    text-transform: uppercase;
}

.unit-card.ult-ready .unit-ult {
    box-shadow: 0 14dp 24dp rgba(0, 0, 0, 18), 0 0 34dp rgba(244, 192, 109, 22);
}

.unit-card.ult-ready .unit-ult-fill {
    background-color: rgba(244, 192, 109, 214);
    decorator: linear-gradient(to bottom, rgba(255, 231, 169, 0.96), rgba(244, 192, 109, 0.96), rgba(255, 142, 190, 0.88)) border-box;
}

.unit-icon {
    position: absolute;
    left: 0;
    bottom: 18dp;
    width: 112dp;
    height: 112dp;
    z-index: 3;
    background-color: transparent;
    image-color: #ffffff;
}

.unit-hp-shell {
    position: absolute;
    left: 38dp;
    bottom: 14dp;
    width: 146dp;
    height: 30dp;
    z-index: 4;
    background-color: rgba(255, 250, 253, 236);
    border: 1dp rgba(23, 20, 31, 36);
    border-radius: 14dp;
    transform: skewX(-18deg);
    box-shadow: 0 10dp 20dp rgba(0, 0, 0, 16);
}

.unit-hp-lane {
    position: absolute;
    left: 3dp;
    top: 3dp;
    width: 140dp;
    height: 24dp;
    background-color: rgba(23, 20, 31, 24);
    border: 1dp rgba(23, 20, 31, 18);
    border-radius: 10dp;
    transform: skewX(18deg);
    overflow: hidden;
}

.unit-hp-fill {
    position: absolute;
    left: 0;
    top: 0;
    height: 24dp;
    width: 100%;
    background-color: #61d59a;
    decorator: linear-gradient(to right, rgba(159, 242, 186, 0.96), rgba(97, 213, 154, 0.94), rgba(66, 176, 126, 0.98)) border-box;
}

.unit-hp-trail {
    position: absolute;
    left: 0;
    top: 0;
    height: 24dp;
    width: 100%;
    background-color: rgba(118, 40, 40, 0.82);
    decorator: linear-gradient(to right, rgba(166, 74, 74, 0.90), rgba(118, 40, 40, 0.88), rgba(88, 28, 28, 0.96)) border-box;
    opacity: 0;
}

.unit-hp-text {
    position: absolute;
    left: 0;
    top: 6dp;
    width: 140dp;
    color: rgba(23, 20, 31, 220);
    font-size: 10dp;
    font-weight: bold;
    letter-spacing: 1dp;
    text-align: center;
}

.unit-shield-stroke {
    position: absolute;
    left: 0;
    top: 0;
    width: 140dp;
    height: 24dp;
}

.unit-shield-line {
    position: absolute;
    background-color: rgba(118, 198, 255, 244);
    box-shadow: 0 0 10dp rgba(118, 198, 255, 26);
    display: none;
}

.unit-shield-line-top,
.unit-shield-line-bottom {
    left: 0;
    width: 0%;
    height: 2dp;
}

.unit-shield-line-top {
    top: 0;
}

.unit-shield-line-bottom {
    bottom: 0;
}

.unit-shield-line-left,
.unit-shield-line-right {
    top: 0;
    width: 2dp;
    height: 24dp;
}

.unit-shield-line-left {
    left: 0;
}

.unit-shield-line-right {
    right: 0;
}

.unit-shield-badge {
    position: absolute;
    right: -2dp;
    bottom: -2dp;
    width: 42dp;
    height: 18dp;
    background-color: rgba(23, 20, 31, 232);
    border: 1dp rgba(255, 255, 255, 32);
    border-radius: 999dp;
    z-index: 6;
}

.unit-shield-icon {
    position: absolute;
    left: 6dp;
    top: 3dp;
    width: 8dp;
    height: 10dp;
    background-color: rgba(118, 198, 255, 244);
    border: 1dp rgba(255, 255, 255, 26);
    border-radius: 2dp 2dp 4dp 4dp;
}

.unit-shield-value {
    position: absolute;
    left: 17dp;
    top: 3dp;
    color: #fff7fb;
    font-size: 8dp;
    font-weight: bold;
    letter-spacing: 1dp;
}

.unit-hit-flash {
    position: absolute;
    left: 0;
    top: 0;
    width: 186dp;
    height: 132dp;
    background-color: rgba(255, 96, 116, 24);
    border-radius: 22dp;
    opacity: 0;
    z-index: 7;
    transition: opacity 0.08s linear;
}

.unit-card.active .unit-hp-shell {
    box-shadow: 0 12dp 24dp rgba(0, 0, 0, 18), 0 0 28dp rgba(255, 103, 182, 20);
}

.battle-tutorial {
    position: absolute;
    left: 50%;
    bottom: 42dp;
    width: 92%;
    max-width: 1200dp;
    margin-left: -600dp;
    opacity: 0;
    display: none;
    z-index: 10;
}

.battle-tutorial.visible {
    display: block;
    opacity: 1;
}

.battle-tutorial-layout {
    position: relative;
    display: flex;
    gap: 32dp;
    align-items: center;
}

.battle-tutorial-speaker {
    position: relative;
    display: inline-block;
    align-self: flex-start;
    padding: 4dp 12dp 5dp 12dp;
    background-color: rgba(36, 44, 58, 236);
    border: 1dp #8f9bad;
    color: #f5f4f1;
    font-size: 18dp;
    line-height: 20dp;
    text-align: center;
}

.battle-tutorial-card {
    position: relative;
    padding: 16dp 24dp 12dp 18dp;
    min-height: 160dp;
    background-color: rgba(5, 10, 18, 218);
    border: 1dp #d5dde8;
    overflow: hidden;
}

.battle-tutorial-portrait {
    position: relative;
    width: 126dp;
    height: 126dp;
    background-color: rgba(10, 14, 24, 230);
    overflow: hidden;
}

.battle-tutorial-copy {
    position: relative;
    flex: 1;
    min-height: 126dp;
    padding-top: 12dp;
    padding-bottom: 22dp;
    display: flex;
    flex-direction: column;
    gap: 12dp;
}

.battle-tutorial-text {
    position: relative;
    flex: 1;
    color: #f5f4ef;
    font-size: 27dp;
    line-height: 34dp;
}

.battle-tutorial-copy .battle-tutorial-speaker {
    margin-top: 8dp;
}

.battle-tutorial-dismiss-hint {
    position: absolute;
    right: 0;
    bottom: 0;
    color: rgba(245, 244, 239, 110);
    font-size: 14dp;
    letter-spacing: 1dp;
    text-align: right;
}

.battle-rhythm-lane {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 36dp;
    background-color: rgba(18, 30, 50, 210);
    border: 1dp #406188;
}

.battle-rhythm {
    position: absolute;
    left: 50%;
    bottom: 44dp;
    width: 90%;
    max-width: 384dp;
    min-height: 148dp;
    margin-left: -192dp;
    padding: 14dp 18dp 54dp 18dp;
    background-color: rgba(11, 16, 28, 238);
    border: 1dp #f0cd4d;
    box-shadow: 0 0 30dp rgba(240, 205, 77, 28);
    opacity: 0;
    display: none;
    z-index: 20;
}

.battle-rhythm.visible {
    display: block;
    opacity: 1;
}

.battle-rhythm-kicker {
    display: block;
    color: #f0cd4d;
    font-size: 11dp;
    letter-spacing: 3dp;
}

.battle-rhythm-title {
    display: none;
}

.battle-rhythm-body {
    display: block;
    clear: both;
    margin-top: 10dp;
    color: #c3d1e4;
    font-size: 14dp;
    letter-spacing: 1dp;
}

.battle-rhythm .battle-rhythm-lane {
    position: absolute;
    left: 18dp;
    right: 18dp;
    bottom: 18dp;
}

.battle-rhythm-window {
    position: absolute;
    left: 206dp;
    top: 4dp;
    width: 62dp;
    height: 26dp;
    background-color: rgba(240, 205, 77, 70);
    border: 1dp #f0cd4d;
}

.battle-rhythm-pulse {
    position: absolute;
    left: 0;
    top: 2dp;
    width: 18dp;
    height: 30dp;
    background-color: #47d7ff;
    box-shadow: 0 0 16dp rgba(71, 215, 255, 62);
}

.battle-result {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
}

.battle-result.active {
    display: block;
}

.battle-result-dim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    background-color: rgba(8, 6, 12, 196);
}

.battle-result-focus {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1040dp;
    height: 540dp;
    margin-left: -520dp;
    margin-top: -270dp;
}

.battle-result-kicker {
    position: absolute;
    left: 0;
    right: 0;
    top: 84dp;
    color: rgba(255, 243, 249, 136);
    font-size: 16dp;
    font-weight: bold;
    letter-spacing: 8dp;
    text-align: center;
    opacity: 0;
    transform: translateY(10dp);
}

.battle-result-word-shell {
    position: absolute;
    left: 0;
    right: 0;
    top: 148dp;
    height: 158dp;
    text-align: center;
}

.battle-result-word {
    display: inline-block;
    width: auto;
    height: 158dp;
    line-height: 1;
    white-space: nowrap;
}

.battle-result-letter {
    display: inline-block;
    margin-left: 10dp;
    font-size: 138dp;
    line-height: 148dp;
    font-weight: bold;
    letter-spacing: 4dp;
    text-transform: uppercase;
}

.battle-result-space {
    display: inline-block;
    width: 30dp;
}

.battle-result.victory .battle-result-letter {
    font-effect: outline(4dp #541237), shadow(0 16dp rgba(84, 18, 55, 142));
}

.battle-result.defeat .battle-result-letter {
    font-effect: outline(4dp #6a1621), shadow(0 16dp rgba(106, 22, 33, 146));
}

.battle-result-button {
    position: absolute;
    left: 50%;
    top: 346dp;
    width: 410dp;
    height: 72dp;
    margin-left: -205dp;
    padding: 0;
    background-color: transparent;
    border: 0;
    overflow: visible;
}

.battle-result-button-stage {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transform: translateY(42dp) scale(0.88);
}

.battle-result-button-shell {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    border-radius: 22dp;
    transform: skewX(-18deg);
}

.battle-result-button-content {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    transform: skewX(18deg);
}

.battle-result.victory .battle-result-button-shell {
    background-color: #ff67b6;
    border: 2dp #ff67b6;
    box-shadow: 0 16dp 28dp rgba(255, 103, 182, 34);
}

.battle-result.defeat .battle-result-button-shell {
    background-color: rgba(255, 251, 253, 238);
    border: 2dp rgba(255, 255, 255, 34);
    box-shadow: 0 16dp 28dp rgba(0, 0, 0, 24);
}

.battle-result-button-accent {
    position: absolute;
    left: 22dp;
    top: 18dp;
    width: 10dp;
    height: 34dp;
    border-radius: 999dp;
}

.battle-result.victory .battle-result-button-accent {
    background-color: rgba(255, 255, 255, 182);
}

.battle-result.defeat .battle-result-button-accent {
    background-color: rgba(23, 20, 31, 42);
}

.battle-result-button-code {
    position: absolute;
    left: 48dp;
    top: 24dp;
    width: 34dp;
    font-size: 11dp;
    font-weight: bold;
    letter-spacing: 2dp;
}

.battle-result.victory .battle-result-button-code {
    color: rgba(255, 255, 255, 214);
}

.battle-result.defeat .battle-result-button-code {
    color: rgba(23, 20, 31, 132);
}

.battle-result-button-main {
    position: absolute;
    left: 96dp;
    top: 14dp;
    right: 124dp;
}

.battle-result-button-label {
    font-size: 22dp;
    font-weight: bold;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.battle-result.victory .battle-result-button-label {
    color: #ffffff;
}

.battle-result.defeat .battle-result-button-label {
    color: #17141f;
}

.battle-result-button-sub {
    margin-top: 4dp;
    font-size: 10dp;
    font-weight: bold;
    letter-spacing: 2dp;
    text-transform: uppercase;
}

.battle-result.victory .battle-result-button-sub {
    color: rgba(255, 255, 255, 194);
}

.battle-result.defeat .battle-result-button-sub {
    color: rgba(23, 20, 31, 126);
}

.battle-result-button-tail {
    position: absolute;
    right: 22dp;
    top: 22dp;
    width: 84dp;
    height: 24dp;
    border-radius: 12dp;
}

.battle-result.victory .battle-result-button-tail {
    background-color: rgba(255, 255, 255, 28);
    border: 1dp rgba(255, 255, 255, 116);
}

.battle-result.defeat .battle-result-button-tail {
    background-color: rgba(255, 103, 182, 18);
    border: 1dp rgba(23, 20, 31, 22);
}

.battle-hint {
    position: absolute;
    left: 50%;
    top: 104dp;
    width: 620dp;
    margin-left: -310dp;
    padding: 12dp 16dp;
    background-color: rgba(255, 255, 255, 210);
    border: 1dp rgba(23, 20, 31, 18);
    border-radius: 16dp;
    box-shadow: 0 10dp 24dp rgba(0, 0, 0, 18);
    color: rgba(23, 20, 31, 132);
    font-size: 11dp;
    font-weight: bold;
    letter-spacing: 1dp;
    line-height: 1.25;
    text-align: center;
    opacity: 0;
    display: none;
}

.battle-hint.visible {
    display: block;
    opacity: 1;
}

.battle-toast {
    position: absolute;
    left: 50%;
    bottom: 186dp;
    width: 480dp;
    height: 40dp;
    margin-left: -240dp;
    background-color: rgba(23, 20, 31, 230);
    border-radius: 999dp;
    color: rgba(255, 255, 255, 232);
    font-size: 12dp;
    font-weight: bold;
    letter-spacing: 1dp;
    line-height: 40dp;
    text-align: center;
    opacity: 0;
    display: none;
}

.battle-toast.visible {
    display: block;
    animation: 0.16s cubic-in-out toast-rise;
    opacity: 1;
}

.battle-pause {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 8, 16, 160);
    z-index: 30;
}

.battle-pause.visible {
    display: block;
}

.battle-pause-shell {
    position: absolute;
    left: 0;
    right: 0;
    top: 92dp;
    width: 620dp;
    margin-left: auto;
    margin-right: auto;
    padding: 28dp 28dp 26dp;
    background-color: rgba(8, 12, 18, 236);
    border: 1dp #c89b5b;
    box-shadow: 0 0 22dp rgba(255, 124, 61, 38);
}

.battle-pause-shell.settings-open {
    width: 760dp;
}

.battle-pause-kicker {
    color: #c89b5b;
    font-size: 12dp;
    letter-spacing: 3dp;
}

.battle-pause-title {
    margin-top: 8dp;
    color: #fff4de;
    font-size: 32dp;
    letter-spacing: 2dp;
}

.battle-pause-hint {
    margin-top: 10dp;
    color: rgba(244, 236, 223, 142);
    font-size: 13dp;
    letter-spacing: 1dp;
}

.battle-pause-menu,
.battle-pause-settings {
    display: none;
    margin-top: 24dp;
}

.battle-pause-menu.visible,
.battle-pause-settings.visible {
    display: block;
}

.battle-pause-button,
.battle-settings-row {
    position: relative;
    margin-top: 12dp;
    padding: 14dp 18dp;
    background-color: rgba(20, 26, 38, 214);
    border: 1dp #415974;
    color: #dfe8f2;
    font-size: 18dp;
    letter-spacing: 1dp;
}

.battle-pause-button.selected,
.battle-settings-row.selected {
    border-color: #f0cd4d;
    box-shadow: 0 0 16dp rgba(240, 205, 77, 24);
    color: #fff3c9;
}

.battle-settings-label {
    font-size: 16dp;
    letter-spacing: 2dp;
}

.battle-settings-value {
    position: absolute;
    right: 18dp;
    top: 14dp;
    color: #f0cd4d;
    font-size: 16dp;
}

.battle-settings-slider {
    width: 100%;
    margin-top: 18dp;
}
