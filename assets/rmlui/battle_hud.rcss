body {
    margin: 0;
    width: 100%;
    height: 100%;
    color: #fff7fb;
    background-color: transparent;
    font-family: "Space Mono";
    position: relative;
}

#hud-root {
    position: relative;
    width: 100%;
    height: 100%;
}

#hud-root.vs-intro-blocking #hud-edge-layer,
#hud-root.vs-intro-blocking .battle-combo,
#hud-root.vs-intro-blocking .battle-total-damage,
#hud-root.vs-intro-blocking .battle-judgement,
#hud-root.vs-intro-blocking .battle-hint-lane,
#hud-root.vs-intro-blocking .battle-input-prompt,
#hud-root.vs-intro-blocking .battle-rhythm,
#hud-root.vs-intro-blocking .battle-result,
#hud-root.vs-intro-blocking .battle-toast,
#hud-root.vs-intro-blocking .battle-pause {
    display: none;
}

#hud-edge-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}

#safe-stage {
    position: absolute;
    left: 0;
    top: 0;
    width: 1280px;
    height: 720px;
}

.battle-combo {
    position: absolute;
    right: 18dp;
    top: 18dp;
    width: 116dp;
    padding: 8dp 10dp 10dp;
    background-color: rgba(18, 14, 24, 176);
    border: 1dp rgba(255, 255, 255, 24);
    border-radius: 16dp;
    box-shadow: 0 12dp 24dp rgba(0, 0, 0, 22);
}

.battle-combo-count {
    text-align: right;
    color: #fff8fb;
    font-size: 30dp;
    font-weight: bold;
    letter-spacing: 1dp;
    line-height: 1;
}

.battle-combo-bonus {
    margin-top: 6dp;
    text-align: right;
    color: rgba(255, 244, 249, 214);
    font-size: 10dp;
    font-weight: bold;
    letter-spacing: 1dp;
}

.battle-combo-meter {
    position: relative;
    margin-top: 8dp;
    width: 100%;
    height: 6dp;
    background-color: rgba(255, 255, 255, 18);
    border-radius: 999dp;
    overflow: hidden;
}

.battle-combo-fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 0%;
    height: 6dp;
    background-color: #ff67b6;
    decorator: linear-gradient(to right, #ff67b6 0%, #f4c06d 52%, #6acff6 100%);
    border-radius: 999dp;
    box-shadow: 0 0 12dp rgba(255, 103, 182, 70);
}

.battle-total-damage {
    position: absolute;
    right: 18dp;
    top: 96dp;
    width: 244dp;
    opacity: 0;
    display: none;
    text-align: right;
    pointer-events: none;
}

.battle-total-damage-label {
    color: rgba(255, 212, 140, 236);
    font-size: 18dp;
    font-weight: bold;
    letter-spacing: 2dp;
    line-height: 1;
    text-transform: uppercase;
    font-effect: outline(1dp #480f33), shadow(0 6dp rgba(72, 15, 51, 116));
}

.battle-total-damage-value {
    margin-top: 4dp;
    width: 100%;
    min-height: 66dp;
    line-height: 1;
    white-space: nowrap;
}

.battle-total-damage-digit {
    display: inline-block;
    margin-left: 4dp;
    font-size: 58dp;
    line-height: 64dp;
    font-weight: bold;
    letter-spacing: 1dp;
    font-effect: outline(2dp #480f33), shadow(0 10dp rgba(72, 15, 51, 132));
}

.battle-total-damage-space {
    display: inline-block;
    width: 14dp;
}

.battle-judgement {
    position: absolute;
    right: 42dp;
    top: 304dp;
    width: 430dp;
    opacity: 0;
    display: none;
    text-align: right;
    pointer-events: none;
}

.battle-judgement-word {
    width: 100%;
    height: 86dp;
    line-height: 1;
    white-space: nowrap;
}

.battle-judgement-letter {
    display: inline-block;
    margin-left: 6dp;
    font-size: 72dp;
    line-height: 82dp;
    font-weight: bold;
    letter-spacing: 2dp;
    text-transform: uppercase;
}

.battle-judgement-space {
    display: inline-block;
    width: 18dp;
}

.battle-judgement-reward {
    display: none;
    margin-top: 2dp;
    color: rgba(255, 248, 251, 226);
    font-size: 20dp;
    font-weight: bold;
    letter-spacing: 2dp;
    text-transform: uppercase;
}

.battle-judgement.perfect .battle-judgement-letter {
    font-effect: outline(2dp #541237), shadow(0 10dp rgba(84, 18, 55, 132));
}

.battle-judgement.good .battle-judgement-letter {
    font-effect: outline(2dp #0d4230), shadow(0 10dp rgba(13, 66, 48, 132));
}

.battle-judgement.okay .battle-judgement-letter {
    font-effect: outline(2dp #653d0d), shadow(0 10dp rgba(101, 61, 13, 132));
}

.battle-judgement.flop .battle-judgement-letter {
    font-effect: outline(2dp #6a1621), shadow(0 10dp rgba(106, 22, 33, 132));
}

.battle-judgement.perfect .battle-judgement-reward {
    font-effect: outline(1dp #541237);
}

.battle-judgement.good .battle-judgement-reward {
    font-effect: outline(1dp #0d4230);
}

.battle-judgement.okay .battle-judgement-reward {
    font-effect: outline(1dp #653d0d);
}

.battle-judgement.flop .battle-judgement-reward {
    font-effect: outline(1dp #6a1621);
}

@keyframes active-turn-bounce {
    from {
        transform: translateX(0dp);
    }
    50% {
        transform: translateX(12dp);
    }
    to {
        transform: translateX(0dp);
    }
}

@keyframes unit-hit-shake {
    from {
        transform: translateX(0dp);
    }
    20% {
        transform: translateX(-6dp);
    }
    40% {
        transform: translateX(5dp);
    }
    60% {
        transform: translateX(-4dp);
    }
    80% {
        transform: translateX(2dp);
    }
    to {
        transform: translateX(0dp);
    }
}

@keyframes toast-rise {
    from {
        transform: translateY(10dp);
        opacity: 0;
    }
    to {
        transform: translateY(0dp);
        opacity: 1;
    }
}

@keyframes battle-hint-accent-sweep {
    from {
        left: -30dp;
    }
    to {
        left: 14dp;
    }
}


.turn-rail {
    position: absolute;
    left: 12dp;
    top: 14dp;
    width: 86dp;
    height: 330dp;
}

.turn-card {
    position: absolute;
    left: 0;
    width: 72dp;
    height: 54dp;
}

#turn-card-1 { top: 0dp; }
#turn-card-2 { top: 62dp; }
#turn-card-3 { top: 124dp; }
#turn-card-4 { top: 186dp; }
#turn-card-5 { top: 248dp; }

.turn-card-shell {
    position: absolute;
    left: 0;
    top: 0;
    width: 72dp;
    height: 54dp;
    background-color: rgba(255, 250, 253, 232);
    border: 1dp rgba(23, 20, 31, 42);
    border-radius: 16dp;
    transform: skewX(-18deg);
    box-shadow: 0 10dp 22dp rgba(0, 0, 0, 22);
}

.turn-card-stripe {
    position: absolute;
    left: 8dp;
    top: 10dp;
    width: 4dp;
    height: 32dp;
    background-color: rgba(255, 103, 182, 132);
    border-radius: 999dp;
}

.turn-card-inner {
    position: absolute;
    left: 0;
    top: 0;
    width: 72dp;
    height: 54dp;
    transform: skewX(18deg);
}

.turn-portrait-frame {
    position: absolute;
    left: 8dp;
    top: 7dp;
    width: 54dp;
    height: 40dp;
    border-radius: 11dp;
    background-color: rgba(23, 20, 31, 18);
    border: 1dp rgba(23, 20, 31, 18);
    overflow: hidden;
}

.turn-portrait {
    position: absolute;
    left: 0;
    top: 0;
    width: 54dp;
    height: 40dp;
    background-color: transparent;
}

.turn-badge {
    position: absolute;
    right: -2dp;
    bottom: -2dp;
    width: 30dp;
    height: 16dp;
    background-color: rgba(23, 20, 31, 234);
    border: 1dp rgba(255, 255, 255, 34);
    border-radius: 9dp;
    transform: skewX(-18deg);
}

.turn-badge-value {
    position: absolute;
    left: 7dp;
    top: 3dp;
    font-size: 9dp;
    font-weight: bold;
    color: #fff7fb;
    transform: skewX(18deg);
}

.turn-card.active {
    animation: active-turn-bounce 0.92s cubic-in-out infinite;
}

.turn-card.active .turn-card-shell {
    border: 2dp #ff67b6;
    box-shadow: 0 12dp 28dp rgba(255, 103, 182, 28);
}

.turn-card.active .turn-card-stripe {
    background-color: #ff67b6;
}

.turn-card.boss .turn-card-shell {
    background-color: rgba(255, 242, 244, 236);
    border: 1dp rgba(236, 95, 102, 58);
}

.turn-card.boss .turn-card-stripe {
    background-color: rgba(236, 95, 102, 158);
}

.turn-card.boss.active .turn-card-shell {
    border: 2dp rgba(236, 95, 102, 214);
    box-shadow: 0 12dp 28dp rgba(236, 95, 102, 26);
}

.boss-band {
    position: absolute;
    left: 110dp;
    right: 24dp;
    top: 8dp;
    height: 80dp;
}

.boss-name {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    padding-left: 18dp;
    padding-right: 18dp;
    text-align: center;
    color: #fff8fb;
    font-size: 28dp;
    font-weight: bold;
    letter-spacing: 1dp;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: clip;
}

.boss-meter-shell {
    position: absolute;
    left: 50%;
    top: 38dp;
    width: 540dp;
    height: 34dp;
    margin-left: -270dp;
    background-color: rgba(255, 250, 253, 238);
    border: 1dp rgba(23, 20, 31, 34);
    border-radius: 16dp;
    transform: skewX(-18deg);
    box-shadow: 0 12dp 26dp rgba(0, 0, 0, 24);
}

.boss-meter-lane {
    position: absolute;
    left: 3dp;
    top: 3dp;
    width: 534dp;
    height: 28dp;
    background-color: rgba(23, 20, 31, 24);
    border: 1dp rgba(23, 20, 31, 18);
    border-radius: 12dp;
    transform: skewX(18deg);
    overflow: hidden;
}

.boss-meter-trail {
    position: absolute;
    left: 0;
    top: 0;
    height: 28dp;
    width: 100%;
    background-color: rgba(120, 26, 42, 0.82);
    decorator: linear-gradient(to right, rgba(162, 54, 74, 0.90), rgba(120, 26, 42, 0.86), rgba(90, 18, 30, 0.94)) border-box;
    opacity: 0;
}

.boss-meter-fill {
    position: absolute;
    left: 0;
    top: 0;
    height: 28dp;
    width: 100%;
    background-color: #ec5f66;
    decorator: linear-gradient(to right, rgba(255, 151, 145, 0.94), rgba(236, 95, 102, 0.94), rgba(210, 64, 85, 0.98)) border-box;
}

.boss-meter-readout {
    position: absolute;
    left: 18dp;
    right: 18dp;
    top: 7dp;
    height: 14dp;
    color: rgba(23, 20, 31, 214);
    font-size: 11dp;
    font-weight: bold;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.boss-readout {
    position: absolute;
    left: 0;
    top: 0;
}

.boss-percent {
    position: absolute;
    right: 0;
    top: 0;
}

.boss-hit-flash {
    position: absolute;
    left: 50%;
    top: 32dp;
    width: 552dp;
    height: 46dp;
    margin-left: -276dp;
    background-color: rgba(255, 96, 116, 0);
    border-radius: 20dp;
    opacity: 0;
}

.boss-band.hit .boss-meter-shell {
    box-shadow: 0 12dp 26dp rgba(0, 0, 0, 24), 0 0 34dp rgba(236, 95, 102, 28);
}

.boss-band.hit .boss-hit-flash {
    opacity: 1;
    background-color: rgba(255, 96, 116, 34);
}

.party-rack {
    position: absolute;
    left: 16dp;
    bottom: 12dp;
    width: 816dp;
    height: 146dp;
}

.unit-card {
    position: absolute;
    bottom: 0;
    width: 186dp;
    height: 132dp;
}

#unit-card-1 { left: 0dp; }
#unit-card-2 { left: 198dp; }
#unit-card-3 { left: 396dp; }
#unit-card-4 { left: 594dp; }

.unit-card.active {
    transform: translateY(-6dp);
}

.unit-card.ghost {
    opacity: 0.56;
}

.unit-ult {
    position: absolute;
    right: 10dp;
    bottom: 34dp;
    width: 88dp;
    height: 88dp;
    background-color: rgba(23, 20, 31, 30);
    border: 1dp rgba(23, 20, 31, 40);
    border-radius: 999dp;
    overflow: hidden;
    z-index: 1;
    box-shadow: 0 12dp 20dp rgba(0, 0, 0, 16);
}

.unit-ult-sheen {
    position: absolute;
    left: -30dp;
    top: -12dp;
    width: 26dp;
    height: 112dp;
    background-color: rgba(255, 255, 255, 164);
    transform: skewX(-18deg) rotate(10deg);
    opacity: 0;
    z-index: 2;
}

.unit-ult-fill {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 88dp;
    height: 0dp;
    background-color: rgba(255, 103, 182, 204);
    decorator: linear-gradient(to bottom, rgba(255, 148, 192, 0.96), rgba(255, 103, 182, 0.94), rgba(248, 183, 96, 0.90)) border-box;
}

.unit-ult-rim {
    position: absolute;
    left: 6dp;
    top: 6dp;
    width: 74dp;
    height: 74dp;
    border: 1dp rgba(255, 255, 255, 40);
    border-radius: 999dp;
}

.unit-ult-core {
    position: absolute;
    left: 18dp;
    top: 28dp;
    width: 52dp;
    height: 16dp;
    color: rgba(23, 20, 31, 224);
    font-size: 10dp;
    font-weight: bold;
    letter-spacing: 1dp;
    text-align: center;
    text-transform: uppercase;
}

.unit-card.ult-ready .unit-ult {
    box-shadow: 0 14dp 24dp rgba(0, 0, 0, 18), 0 0 34dp rgba(244, 192, 109, 22);
}

.unit-card.ult-ready .unit-ult-fill {
    background-color: rgba(244, 192, 109, 214);
    decorator: linear-gradient(to bottom, rgba(255, 231, 169, 0.96), rgba(244, 192, 109, 0.96), rgba(255, 142, 190, 0.88)) border-box;
}

.unit-icon {
    position: absolute;
    left: 0;
    bottom: 18dp;
    width: 112dp;
    height: 112dp;
    z-index: 3;
    background-color: transparent;
    image-color: #ffffff;
}

.unit-hp-shell {
    position: absolute;
    left: 38dp;
    bottom: 14dp;
    width: 146dp;
    height: 30dp;
    z-index: 4;
    background-color: rgba(255, 250, 253, 236);
    border: 1dp rgba(23, 20, 31, 36);
    border-radius: 14dp;
    transform: skewX(-18deg);
    box-shadow: 0 10dp 20dp rgba(0, 0, 0, 16);
}

.unit-hp-lane {
    position: absolute;
    left: 3dp;
    top: 3dp;
    width: 140dp;
    height: 24dp;
    background-color: rgba(23, 20, 31, 24);
    border: 1dp rgba(23, 20, 31, 18);
    border-radius: 10dp;
    transform: skewX(18deg);
    overflow: hidden;
}

.unit-hp-fill {
    position: absolute;
    left: 0;
    top: 0;
    height: 24dp;
    width: 100%;
    background-color: #61d59a;
    decorator: linear-gradient(to right, rgba(159, 242, 186, 0.96), rgba(97, 213, 154, 0.94), rgba(66, 176, 126, 0.98)) border-box;
}

.unit-hp-trail {
    position: absolute;
    left: 0;
    top: 0;
    height: 24dp;
    width: 100%;
    background-color: rgba(118, 40, 40, 0.82);
    decorator: linear-gradient(to right, rgba(166, 74, 74, 0.90), rgba(118, 40, 40, 0.88), rgba(88, 28, 28, 0.96)) border-box;
    opacity: 0;
}

.unit-hp-text {
    position: absolute;
    left: 0;
    top: 6dp;
    width: 140dp;
    color: rgba(23, 20, 31, 220);
    font-size: 10dp;
    font-weight: bold;
    letter-spacing: 1dp;
    text-align: center;
}

.unit-shield-stroke {
    position: absolute;
    left: 0;
    top: 0;
    width: 140dp;
    height: 24dp;
}

.unit-shield-line {
    position: absolute;
    background-color: rgba(118, 198, 255, 244);
    box-shadow: 0 0 10dp rgba(118, 198, 255, 26);
    display: none;
}

.unit-shield-line-top,
.unit-shield-line-bottom {
    left: 0;
    width: 0%;
    height: 2dp;
}

.unit-shield-line-top {
    top: 0;
}

.unit-shield-line-bottom {
    bottom: 0;
}

.unit-shield-line-left,
.unit-shield-line-right {
    top: 0;
    width: 2dp;
    height: 24dp;
}

.unit-shield-line-left {
    left: 0;
}

.unit-shield-line-right {
    right: 0;
}

.unit-shield-badge {
    position: absolute;
    right: -2dp;
    bottom: -2dp;
    width: 42dp;
    height: 18dp;
    background-color: rgba(23, 20, 31, 232);
    border: 1dp rgba(255, 255, 255, 32);
    border-radius: 999dp;
    z-index: 6;
}

.unit-shield-icon {
    position: absolute;
    left: 6dp;
    top: 3dp;
    width: 8dp;
    height: 10dp;
    background-color: rgba(118, 198, 255, 244);
    border: 1dp rgba(255, 255, 255, 26);
    border-radius: 2dp 2dp 4dp 4dp;
}

.unit-shield-value {
    position: absolute;
    left: 17dp;
    top: 3dp;
    color: #fff7fb;
    font-size: 8dp;
    font-weight: bold;
    letter-spacing: 1dp;
}

.unit-hit-flash {
    position: absolute;
    left: 0;
    top: 0;
    width: 186dp;
    height: 132dp;
    background-color: rgba(255, 96, 116, 24);
    border-radius: 22dp;
    opacity: 0;
    z-index: 7;
    transition: opacity 0.08s linear;
}

.unit-card.active .unit-hp-shell {
    box-shadow: 0 12dp 24dp rgba(0, 0, 0, 18), 0 0 28dp rgba(255, 103, 182, 20);
}

.battle-hint-lane {
    position: absolute;
    left: 50%;
    top: 92dp;
    width: 860dp;
    margin-left: -430dp;
    display: none;
    z-index: 14;
}

.battle-hint-stack {
    position: relative;
    width: 100%;
    height: 0dp;
}

.battle-hint-slot {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 0dp;
    overflow: visible;
}

.battle-hint-shell {
    position: absolute;
    left: 50%;
    top: 0;
    display: block;
    width: 0dp;
    max-width: 790dp;
    background-color: rgba(11, 15, 24, 204);
    border: 1dp rgba(255, 255, 255, 16);
    box-shadow: 0 8dp 18dp rgba(0, 0, 0, 14);
    transform: skewX(-18deg);
    overflow: hidden;
    opacity: 0;
}

.battle-hint-inner {
    position: relative;
    min-height: 0dp;
    padding: 3dp 8dp 4dp 8dp;
    display: flex;
    gap: 6dp;
    align-items: stretch;
    transform: skewX(18deg);
}

.battle-hint-accent {
    position: relative;
    width: 5dp;
    min-height: 18dp;
    background-color: #9dbfe9;
    overflow: hidden;
}

.battle-hint-accent-shine {
    position: absolute;
    left: -10dp;
    top: -3dp;
    width: 6dp;
    height: 30dp;
    background-color: rgba(255, 255, 255, 58);
    transform: skewX(-18deg);
    animation: battle-hint-accent-sweep 1.9s linear infinite;
}

.battle-hint-copy {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0;
    transform: translateY(10dp);
}

.battle-hint-topline {
    display: none;
}

.battle-hint-message {
    margin-top: 0dp;
    color: rgba(255, 248, 251, 240);
    font-size: 12dp;
    line-height: 13dp;
    font-weight: bold;
    text-align: center;
}

.battle-hint-side {
    display: none;
}

.battle-hint-timer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2dp;
    background-color: rgba(255, 255, 255, 14);
    overflow: hidden;
}

.battle-hint-timer-fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 2dp;
    background-color: #9dbfe9;
}

.battle-hint-slot.family-info .battle-hint-shell {
    background-color: rgba(12, 16, 26, 198);
    border-color: rgba(205, 220, 241, 18);
}

.battle-hint-slot.family-tutorial .battle-hint-shell {
    background-color: rgba(10, 15, 24, 198);
    border-color: rgba(157, 191, 233, 24);
}

.battle-hint-slot.family-warning .battle-hint-shell {
    background-color: rgba(24, 11, 14, 206);
    border-color: rgba(255, 106, 117, 32);
}

.battle-hint-slot.family-major .battle-hint-shell {
    background-color: rgba(19, 12, 24, 206);
    border-color: rgba(255, 103, 182, 32);
}

.battle-hint-slot.family-info .battle-hint-accent,
.battle-hint-slot.family-info .battle-hint-timer-fill {
    background-color: #d9e3ef;
}

.battle-hint-slot.family-tutorial .battle-hint-accent,
.battle-hint-slot.family-tutorial .battle-hint-timer-fill {
    background-color: #9dbfe9;
}

.battle-hint-slot.family-warning .battle-hint-accent,
.battle-hint-slot.family-warning .battle-hint-timer-fill {
    background-color: #ff7b73;
}

.battle-hint-slot.family-major .battle-hint-accent,
.battle-hint-slot.family-major .battle-hint-timer-fill {
    background-color: #ff67b6;
}

.battle-hint-measure-host {
    position: absolute;
    left: -4000dp;
    top: -4000dp;
    width: 860dp;
    height: auto;
    opacity: 0;
    overflow: visible;
}

.battle-hint-measure-host .battle-hint-slot {
    position: relative;
    left: 0;
    top: 0;
    height: auto;
}

.battle-hint-measure-host .battle-hint-shell {
    position: relative;
    left: 0;
    top: 0;
    margin-left: 0dp;
    width: auto;
    opacity: 1;
}

.battle-hint-measure-host .battle-hint-copy {
    opacity: 1;
    transform: translateY(0dp);
}

.battle-input-prompt {
    position: absolute;
    right: 34dp;
    bottom: 30dp;
    width: 164dp;
    display: none;
    z-index: 18;
}

.battle-input-prompt.visible {
    display: block;
}

.battle-input-prompt.has-follow-up.has-primary {
    width: 212dp;
}

.battle-input-prompt.type-wild {
    width: 232dp;
}

.battle-input-prompt.type-arrows,
.battle-input-prompt.type-custom {
    width: 220dp;
}

.battle-input-prompt.type-left-right,
.battle-input-prompt.type-spam-space {
    width: 176dp;
}

.battle-input-prompt-shell {
    position: relative;
    padding: 12dp 14dp 13dp 14dp;
    display: flex;
    flex-direction: column;
    background-color: rgba(10, 14, 24, 232);
    border: 1dp rgba(255, 255, 255, 20);
    border-radius: 18dp;
    box-shadow: 0 18dp 40dp rgba(0, 0, 0, 28), 0 0 28dp rgba(255, 103, 182, 14);
    overflow: hidden;
}

.battle-input-prompt-row {
    position: relative;
    width: 100%;
    overflow: visible;
}

.battle-input-prompt-row-primary {
    min-height: 40dp;
}

.battle-input-prompt-row-plus {
    margin-top: 6dp;
    text-align: center;
}

.battle-input-prompt-row-follow-up {
    margin-top: 0dp;
}

.battle-input-prompt.has-primary.has-follow-up .battle-input-prompt-row-follow-up {
    margin-top: 6dp;
}

.battle-input-prompt-key {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38dp;
    min-width: 38dp;
    height: 36dp;
    padding: 0dp;
    background-color: rgba(16, 20, 30, 246);
    border: 1dp rgba(255, 255, 255, 16);
    border-radius: 12dp;
    box-shadow: 0 5dp 0 rgba(4, 5, 8, 224), 0 12dp 20dp rgba(0, 0, 0, 18);
    transform-origin: 50% 50%;
    transform: translateY(0dp);
    overflow: hidden;
}

.battle-input-prompt-key.is-pressed {
    box-shadow: 0 1dp 0 rgba(4, 5, 8, 224), 0 6dp 12dp rgba(0, 0, 0, 18);
    background-color: rgba(22, 28, 41, 248);
    border-color: rgba(255, 103, 182, 32);
}

.battle-input-prompt-key-line {
    position: absolute;
    left: 8dp;
    right: 8dp;
    top: 6dp;
    height: 2dp;
    border-radius: 999dp;
    background-color: rgba(255, 255, 255, 22);
}

.battle-input-prompt-key.is-pressed .battle-input-prompt-key-line {
    background-color: rgba(255, 255, 255, 34);
}

.battle-input-prompt-key-label {
    position: relative;
    z-index: 1;
    text-align: center;
    color: #fff8fb;
    font-size: 12dp;
    font-weight: bold;
    letter-spacing: 1dp;
    line-height: 1;
    text-transform: uppercase;
}

.battle-input-prompt-key-primary {
    width: 126dp;
    min-width: 126dp;
    margin-left: auto;
    margin-right: auto;
}

.battle-input-prompt-key-primary .battle-input-prompt-key-line,
.battle-input-prompt-key.is-space .battle-input-prompt-key-line {
    left: 20dp;
    right: 20dp;
    top: 7dp;
}

.battle-input-prompt-key-primary .battle-input-prompt-key-label,
.battle-input-prompt-key.is-space .battle-input-prompt-key-label {
    letter-spacing: 3dp;
}

.battle-input-prompt-key.is-space {
    width: 126dp;
    min-width: 126dp;
}

.battle-input-prompt-plus {
    display: inline-block;
    color: rgba(255, 248, 251, 176);
    font-size: 18dp;
    font-weight: bold;
    line-height: 1;
}

.battle-input-prompt-follow-up {
    position: relative;
    width: 100%;
    overflow: visible;
}

.battle-input-prompt-follow-up-strip {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 6dp;
}

.battle-input-prompt-follow-up-arrows {
    display: none;
    overflow: visible;
}

.battle-input-prompt-arrow-row {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 6dp;
}

.battle-input-prompt-arrow-row-bottom {
    margin-top: 4dp;
}

.battle-input-prompt-key-secondary {
    width: 38dp;
    min-width: 38dp;
    height: 36dp;
}

.battle-input-prompt.type-left-right .battle-input-prompt-follow-up-strip {
    gap: 10dp;
}

.battle-input-prompt.type-wild .battle-input-prompt-key-secondary {
    width: 32dp;
    min-width: 32dp;
    height: 32dp;
    border-radius: 10dp;
}

.battle-input-prompt.type-wild .battle-input-prompt-follow-up-strip {
    gap: 4dp;
}

.battle-input-prompt.type-wild .battle-input-prompt-key-secondary .battle-input-prompt-key-line {
    left: 6dp;
    right: 6dp;
    top: 5dp;
}

.battle-input-prompt.type-wild .battle-input-prompt-key-secondary .battle-input-prompt-key-label {
    font-size: 11dp;
}

.battle-rhythm-lane {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 36dp;
    background-color: rgba(18, 30, 50, 210);
    border: 1dp #406188;
}

.battle-rhythm {
    position: absolute;
    left: 50%;
    bottom: 44dp;
