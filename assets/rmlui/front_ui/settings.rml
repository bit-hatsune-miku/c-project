<rml>
<head>
    <title>Settings</title>
    <link type="text/rcss" href="submenu_revamp.rcss"/>
</head>
<body>
    <div id="settings-screen" class="submenu-screen">
        <img id="settings-logo" class="submenu-logo" src="../../vn/backgrounds/General_Art/MainMenuTitle.png"/>

        <div id="settings-panel" class="submenu-panel">
            <div id="settings-shell">
                <div class="submenu-outline"></div>
                <div class="submenu-kicker">SYSTEM CONFIG / FRONTEND NODE</div>
                <div class="submenu-title">SETTINGS</div>
                <div class="submenu-copy">Tune presentation and readability here, then slip straight back to the menu without triggering the big opening intro again.</div>

                <div id="settings-list">
                    <button id="settings-row-display" class="submenu-row is-selected">
                        <div class="submenu-row-content">
                            <div class="submenu-row-accent"></div>
                            <div id="settings-code-display" class="submenu-row-code"></div>
                            <div class="submenu-row-main">
                                <div id="settings-label-display" class="submenu-row-label"></div>
                                <div class="submenu-row-sub">WINDOW / FULLSCREEN</div>
                            </div>
                            <div id="settings-display-value" class="submenu-row-value"></div>
                            <div class="submenu-row-tail"></div>
                        </div>
                    </button>

                    <div id="settings-row-music" class="submenu-row submenu-row-slider">
                        <div class="submenu-row-content">
                            <div class="submenu-row-accent"></div>
                            <div id="settings-code-music" class="submenu-row-code"></div>
                            <div class="submenu-row-main">
                                <div id="settings-label-music" class="submenu-row-label"></div>
                                <div class="submenu-row-sub">MENU / STORY BGM LEVEL</div>
                            </div>
                            <div id="settings-music-value" class="submenu-row-value"></div>
                            <input class="submenu-slider" id="settings-music-slider" type="range" min="0" max="100" step="5" value="0" />
                            <div class="submenu-row-tail"></div>
                        </div>
                    </div>

                    <div id="settings-row-voice" class="submenu-row submenu-row-slider">
                        <div class="submenu-row-content">
                            <div class="submenu-row-accent"></div>
                            <div id="settings-code-voice" class="submenu-row-code"></div>
                            <div class="submenu-row-main">
                                <div id="settings-label-voice" class="submenu-row-label"></div>
                                <div class="submenu-row-sub">DIALOGUE OUTPUT LEVEL</div>
                            </div>
                            <div id="settings-voice-value" class="submenu-row-value"></div>
                            <input class="submenu-slider" id="settings-voice-slider" type="range" min="0" max="100" step="5" value="0" />
                            <div class="submenu-row-tail"></div>
                        </div>
                    </div>

                    <div id="settings-row-text" class="submenu-row submenu-row-slider">
                        <div class="submenu-row-content">
                            <div class="submenu-row-accent"></div>
                            <div id="settings-code-text" class="submenu-row-code"></div>
                            <div class="submenu-row-main">
                                <div id="settings-label-text" class="submenu-row-label"></div>
                                <div class="submenu-row-sub">VN CHARACTERS PER SECOND</div>
                            </div>
                            <div id="settings-text-value" class="submenu-row-value"></div>
                            <input class="submenu-slider" id="settings-text-slider" type="range" min="18" max="90" step="6" value="18" />
                            <div class="submenu-row-tail"></div>
                        </div>
                    </div>

                    <button id="settings-row-back" class="submenu-row">
                        <div class="submenu-row-content">
                            <div class="submenu-row-accent"></div>
                            <div id="settings-code-back" class="submenu-row-code"></div>
                            <div class="submenu-row-main">
                                <div id="settings-label-back" class="submenu-row-label"></div>
                                <div class="submenu-row-sub">NO FADE, JUST EASE BACK</div>
                            </div>
                            <div id="settings-back-value" class="submenu-row-value"></div>
                            <div class="submenu-row-tail"></div>
                        </div>
                    </button>
                </div>
            </div>

            <div id="settings-focus-shell">
                <div class="submenu-outline"></div>
                <div id="settings-focus-code" class="submenu-detail-kicker"></div>
                <div id="settings-focus-title" class="submenu-detail-title"></div>
                <div id="settings-focus-copy" class="submenu-detail-copy"></div>

                <div class="submenu-preview-card">
                    <div id="settings-preview-chip" class="submenu-preview-chip">LIVE VALUE</div>
                    <div id="settings-preview-main-value" class="submenu-preview-value">WINDOWED</div>

                    <div class="submenu-preview-meter">
                        <div class="submenu-preview-meter-label">MUSIC</div>
                        <div class="submenu-preview-track">
                            <div id="settings-preview-music-fill" class="submenu-preview-fill"></div>
                        </div>
                    </div>

                    <div class="submenu-preview-meter">
                        <div class="submenu-preview-meter-label">VOICE</div>
                        <div class="submenu-preview-track">
                            <div id="settings-preview-voice-fill" class="submenu-preview-fill"></div>
                        </div>
                    </div>

                    <div class="submenu-preview-meter">
                        <div class="submenu-preview-meter-label">TEXT SPEED</div>
                        <div class="submenu-preview-track">
                            <div id="settings-preview-text-fill" class="submenu-preview-fill"></div>
                        </div>
                    </div>
                </div>

                <div class="submenu-detail-grid">
                    <div class="submenu-detail-cell">
                        <div class="submenu-detail-label">Display</div>
                        <div id="settings-context-display" class="submenu-detail-value">Windowed</div>
                    </div>
                    <div class="submenu-detail-cell">
                        <div class="submenu-detail-label">Music</div>
                        <div id="settings-context-music" class="submenu-detail-value">100%</div>
                    </div>
                    <div class="submenu-detail-cell">
                        <div class="submenu-detail-label">Voice</div>
                        <div id="settings-context-voice" class="submenu-detail-value">82%</div>
                    </div>
                    <div class="submenu-detail-cell">
                        <div class="submenu-detail-label">Text</div>
                        <div id="settings-context-speed" class="submenu-detail-value">42 CPS</div>
                    </div>
                    <div class="submenu-detail-cell">
                        <div class="submenu-detail-label">Return</div>
                        <div id="settings-context-return" class="submenu-detail-value">Main Menu</div>
                    </div>
                </div>

                <div class="submenu-footer-hint">UP OR DOWN TO FOCUS. LEFT OR RIGHT TO ADJUST. ESC RETURNS.</div>
            </div>
        </div>
    </div>
</body>
</rml>
