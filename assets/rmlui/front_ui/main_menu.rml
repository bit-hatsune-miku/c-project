<rml>
<head>
    <title>Main Menu</title>
    <link type="text/rcss" href="main_menu_revamp.rcss"/>
    <link type="text/rcss" href="../shared/ui_music_bars.rcss"/>
</head>
<body>
    <div id="main-menu-root">
        <div id="ui-music-bars-root" class="ui-music-bars-root">
            <div id="ui-music-bars-track" class="ui-music-bars-track"></div>
        </div>

        <div id="main-menu-disc-layer">
            <div id="disc-outer"></div>
            <div id="disc-ring-a"></div>
            <div id="disc-ring-b"></div>
            <div id="disc-core"></div>
            <div id="disc-core-hole"></div>
        </div>

        <div id="main-menu-logo-layer">
            <div id="title-logo-shell">
                <img id="title-logo" src="../../vn/backgrounds/General_Art/MainMenuTitle.png"/>
            </div>
        </div>

        <div id="main-menu-ui-layer">
            <div id="menu-title-hint">STORY MODE</div>

            <div id="menu-stack">
                <button id="menu-button-start" class="menu-button is-selected">
                    <div class="menu-button-content">
                        <div class="menu-button-accent"></div>
                        <div id="menu-button-code-start" class="menu-button-code"></div>
                        <div id="menu-button-label-start" class="menu-button-label"></div>
                        <div class="menu-button-glow"></div>
                    </div>
                </button>

                <button id="menu-button-load" class="menu-button">
                    <div class="menu-button-content">
                        <div class="menu-button-accent"></div>
                        <div id="menu-button-code-load" class="menu-button-code"></div>
                        <div id="menu-button-label-load" class="menu-button-label"></div>
                        <div class="menu-button-glow"></div>
                    </div>
                </button>

                <button id="menu-button-battle" class="menu-button">
                    <div class="menu-button-content">
                        <div class="menu-button-accent"></div>
                        <div id="menu-button-code-battle" class="menu-button-code"></div>
                        <div id="menu-button-label-battle" class="menu-button-label"></div>
                        <div class="menu-button-glow"></div>
                    </div>
                </button>

                <button id="menu-button-settings" class="menu-button">
                    <div class="menu-button-content">
                        <div class="menu-button-accent"></div>
                        <div id="menu-button-code-settings" class="menu-button-code"></div>
                        <div id="menu-button-label-settings" class="menu-button-label"></div>
                        <div class="menu-button-glow"></div>
                    </div>
                </button>

                <button id="menu-button-exit" class="menu-button">
                    <div class="menu-button-content">
                        <div class="menu-button-accent"></div>
                        <div id="menu-button-code-exit" class="menu-button-code"></div>
                        <div id="menu-button-label-exit" class="menu-button-label"></div>
                        <div class="menu-button-glow"></div>
                    </div>
                </button>
            </div>
        </div>

        <div id="main-menu-fixed-layer">
            <div id="menu-status">
                <div id="menu-focus-code"></div>
                <div id="menu-status-title"></div>
                <div id="menu-status-copy"></div>
            </div>

            <div id="corner-kicker">ARROWS OR WASD TO MOVE. ENTER, SPACE, OR CLICK TO CHOOSE.</div>
        </div>

        <div id="menu-intro-whiteout"></div>
    </div>
</body>
</rml>
