body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    color: #17141f;
    font-family: "Space Mono";
}

#pause-overlay {
    position: absolute;
    left: 0; top: 0; width: 100%; height: 100%;
    background-color: rgba(2,8,10,0.28);
    backdrop-filter: blur(8px) saturate(120%);
}

#pause-shell {
    position: absolute;
    left: 20.5%; right: 20.5%; top: 10%; bottom: 10%;
    background-color: rgba(255,255,255,0.92);
    border: 1dp rgba(23,20,31,0.1);
    border-radius: 24dp;
    box-shadow: 0 12dp 36dp rgba(23,20,31,16);
    transform: translateY(-8%);
    opacity: 0;
    transition: transform 520ms cubic-bezier(.22,1,.36,1), opacity 420ms ease;
}

#pause-shell.entered { transform: translateY(0); opacity: 1; }

#pause-logo { display: block; width: 420dp; margin: 18dp auto 6dp auto; }

#pause-title-shell { position: absolute; left: 50%; top: 40dp; width: 560dp; margin-left: -280dp; }
#pause-kicker { font-size: 12dp; letter-spacing: 2.8dp; color: rgba(23,20,31,0.54); text-align:center }
#pause-title { font-size: 38dp; font-weight: bold; letter-spacing: 4dp; text-align:center; color: #17141f }

#pause-buttons { position: absolute; left: 50%; top: 144dp; width: 540dp; margin-left: -270dp; display: block }
.pause-button { position: relative; display: block; width: 540dp; height: 52dp; margin-bottom: 10dp; background: transparent; border: 0 }
.pause-button::before { content: ''; position: absolute; inset: 0; border-radius: 14dp; background: rgba(255,255,255,0.96); border: 1dp rgba(23,20,31,0.08); transform: skewX(-18deg) }
.pause-inner { position: absolute; inset: 0; display:flex; align-items:center; gap: 12dp; padding: 10dp 16dp; transform: skewX(-18deg) }
.pause-inner > * { transform: skewX(18deg) }
.pause-accent { width: 10dp; height: 28dp; border-radius: 999dp; background: rgba(23,20,31,0.18) }
.pause-code { min-width:40dp; font-size: 12dp; font-weight: bold; color: rgba(23,20,31,0.54) }
.pause-label { flex: 1; font-size: 18dp; font-weight: bold; text-transform: uppercase; color: #17141f }
.pause-tail { width: 68dp; height: 22dp; border-radius: 999dp; background: rgba(255,255,255,0.22); opacity: 0; transition: opacity 260ms }

.pause-button.is-selected::before { background: #ff63b0; border-color: rgba(255,99,176,0.92) }
.pause-button.is-selected .pause-accent { background: rgba(255,255,255,0.8) }
.pause-button.is-selected .pause-code { color: rgba(255,255,255,0.86) }
.pause-button.is-selected .pause-label { color: #fff }
.pause-button.is-selected .pause-tail { opacity: 1 }

#pause-notice { position: absolute; left: 0; right: 0; bottom: 28dp; text-align:center; color: rgba(23,20,31,0.48); font-size: 12dp }

#pause-confirm { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); display: none }

#pause-toast { position: absolute; left: 50%; bottom: 36dp; transform: translateX(-50%); background: rgba(23,20,31,0.9); color: #fff; padding: 12dp 16dp; border-radius: 10dp; font-weight: bold; opacity: 0; transition: opacity 240ms, transform 240ms }
#pause-toast.is-visible { opacity: 1; transform: translateX(-50%) translateY(-6dp) }

/* small */
@media (max-width: 520dp) {
    #pause-shell { left: 6dp; right: 6dp; top: 6dp; bottom: 6dp }
    #pause-logo { width: 280dp }
}
