}

#load-empty-state.is-visible {
    display: block;
}

#load-footer {
    position: absolute;
    left: 214dp;
    bottom: 50dp;
    width: 472dp;
    height: 54dp;
}

#load-notice {
    position: absolute;
    left: 150dp;
    bottom: 18dp;
    width: 600dp;
    height: 20dp;
    font-size: 12dp;
    letter-spacing: 0.4dp;
    color: #ffd58a;
    text-align: center;
}

#load-footer-delete {
