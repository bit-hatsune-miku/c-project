    right: 0;
    top: 0;
    width: 228dp;
}

#load-slot-list {
    position: absolute;
    left: 54dp;
    top: 174dp;
    width: 792dp;
    height: 340dp;
}

.load-slot-button {
    position: relative;
    display: block;
    width: 792dp;
    height: 58dp;
    margin-bottom: 12dp;
    background-color: rgba(8, 22, 24, 128);
    border: 1dp rgba(93, 255, 241, 44);
}

.load-slot-button.is-selected {
    background-color: rgba(57, 197, 187, 48);
    border: 1dp rgba(125, 255, 245, 172);
}

