body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: transparent;
    color: #ebffff;
    font-family: "Space Mono";
}

button {
    cursor: pointer;
    background-color: transparent;
    border: 0;
    padding: 0;
}

.is-hidden {
    display: none;
}

@keyframes signal-breathe {
    from {
        opacity: 0.42;
    }
    to {
        opacity: 0.88;
    }
}

#bg-art {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

#bg-dim {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(2, 10, 11, 170);
}

#bg-top-glow {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 240px;
    background-color: rgba(57, 197, 187, 24);
}

#bg-grid-vertical {
    position: absolute;
    left: 56px;
    top: 36px;
    width: 1px;
    height: 648px;
    background-color: rgba(86, 255, 241, 62);
}

#bg-grid-horizontal {
    position: absolute;
    left: 56px;
    top: 634px;
    width: 1168px;
    height: 1px;
    background-color: rgba(86, 255, 241, 36);
}

#hero-frame {
    position: absolute;
    left: 332px;
    top: 72px;
    width: 892px;
    height: 532px;
    border: 1dp rgba(87, 255, 241, 32);
}

#hero-reticle {
    position: absolute;
    right: 124px;
    top: 116px;
    width: 108px;
    height: 108px;
    border: 1dp rgba(95, 255, 245, 64);
}

#menu-column {
    position: absolute;
    left: 72px;
    top: 56px;
    width: 470px;
    height: 608px;
}

#title-shell {
    position: absolute;
    left: 0;
    top: 0;
    width: 470px;
    height: 170px;
    background-color: rgba(4, 12, 14, 188);
    border: 1dp rgba(93, 255, 241, 104);
}

#title-kicker {
    position: absolute;
    left: 22px;
    top: 18px;
    font-size: 12px;
    letter-spacing: 2.8px;
    color: rgba(153, 255, 246, 220);
}

#title-logo {
    position: absolute;
    left: 18px;
    top: 38px;
    width: 430px;
    height: 130px;
}

#menu-shell {
    position: absolute;
    left: 0;
    top: 192px;
    width: 470px;
    height: 416px;
    background-color: rgba(4, 12, 14, 204);
    border: 1dp rgba(93, 255, 241, 96);
}

#menu-header-row {
    position: absolute;
    left: 22px;
    top: 20px;
    width: 426px;
    height: 22px;
}

#menu-section-tag {
    position: absolute;
    left: 0;
    top: 0;
    font-size: 15px;
    font-weight: bold;
    letter-spacing: 3px;
    color: #8ffff6;
}

#menu-system-chip {
    position: absolute;
    right: 0;
    top: 0;
    font-size: 11px;
    letter-spacing: 2.2px;
    color: rgba(210, 255, 251, 172);
}

.front-shell-panel {
    background-color: rgba(8, 20, 22, 210);
    border: 1dp rgba(87, 255, 241, 60);
}

#menu-status-card {
    position: absolute;
    left: 22px;
    top: 58px;
    width: 426px;
    height: 72px;
}

#menu-focus-code {
    position: absolute;
    left: 16px;
    top: 19px;
    width: 50px;
    height: 20px;
    font-size: 18px;
    font-weight: bold;
    letter-spacing: 1px;
    color: #93fff7;
}

#menu-status-copy-group {
    position: absolute;
    left: 78px;
    top: 13px;
    width: 328px;
    height: 48px;
}

#menu-status-title {
    position: absolute;
    left: 0;
    top: 0;
    font-size: 15px;
    font-weight: bold;
    letter-spacing: 1.8px;
    color: #f0fffd;
}

#menu-status-copy {
    position: absolute;
    left: 0;
    top: 24px;
    width: 328px;
    font-size: 11px;
    letter-spacing: 0.5px;
    color: rgba(213, 255, 250, 176);
}

#menu-buttons {
    position: absolute;
    left: 22px;
    top: 150px;
    width: 426px;
    height: 210px;
}

.menu-button {
    position: relative;
    display: block;
    width: 426px;
    height: 38px;
    margin-bottom: 10px;
    background-color: rgba(8, 22, 24, 124);
    border: 1dp rgba(93, 255, 241, 38);
    color: #efffff;
}

.menu-button-beam {
    position: absolute;
    left: -1dp;
    top: -1dp;
    width: 4px;
    height: 38px;
    background-color: rgba(98, 255, 243, 78);
}

.menu-button-code {
    position: absolute;
    left: 14px;
    top: 10px;
    width: 32px;
    height: 16px;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 1px;
    color: rgba(184, 255, 248, 184);
}

.menu-button-label {
    position: absolute;
    left: 74px;
    top: 6px;
    font-size: 18px;
    font-weight: bold;
    letter-spacing: 1.8px;
}

.menu-button-detail {
    position: absolute;
    right: 14px;
    top: 10px;
    font-size: 10px;
    letter-spacing: 1.8px;
    color: rgba(189, 255, 248, 140);
}

.menu-button.is-selected {
    background-color: rgba(57, 197, 187, 48);
    border: 1dp rgba(125, 255, 245, 180);
    color: #f8ffff;
}

.menu-button.is-selected .menu-button-beam {
    background-color: rgba(125, 255, 245, 220);
    animation: 1.5s infinite alternate signal-breathe;
}

.menu-button.is-selected .menu-button-code {
    color: #b8fff9;
}

.menu-button.is-selected .menu-button-detail {
    color: rgba(236, 255, 252, 188);
}

#system-caption {
    position: absolute;
    right: 72px;
    bottom: 62px;
    width: 314px;
    height: 118px;
    background-color: rgba(4, 12, 14, 170);
    border: 1dp rgba(93, 255, 241, 54);
}

#system-caption-line {
    position: absolute;
    left: 22px;
    top: 18px;
    width: 82px;
    height: 2px;
    background-color: rgba(114, 255, 245, 196);
}

#system-caption-label {
    position: absolute;
    left: 22px;
    top: 28px;
    font-size: 11px;
    letter-spacing: 3px;
    color: rgba(154, 255, 247, 220);
}

#system-caption-title {
    position: absolute;
    left: 22px;
    top: 48px;
    width: 268px;
    font-size: 15px;
    font-weight: bold;
    letter-spacing: 1.2px;
    color: #f3fffd;
}

#system-caption-copy {
    position: absolute;
    left: 22px;
    top: 82px;
    width: 268px;
    font-size: 10px;
    letter-spacing: 0.4px;
    color: rgba(216, 255, 251, 162);
}

#settings-overlay,
#pause-overlay,
#load-overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(5, 12, 16, 186);
}

#settings-shell {
    position: absolute;
    left: 5.5%;
    right: 5.5%;
    top: 7.5%;
    bottom: 7.5%;
    background-color: rgba(4, 12, 14, 206);
    border: 1dp rgba(93, 255, 241, 96);
}

#settings-title-shell {
    position: absolute;
    left: 26px;
    top: 24px;
    width: 618px;
    height: 114px;
    background-color: rgba(6, 18, 21, 196);
    border: 1dp rgba(93, 255, 241, 90);
}

#settings-kicker {
    position: absolute;
    left: 22px;
    top: 16px;
    font-size: 12px;
    letter-spacing: 2.8px;
    color: rgba(161, 255, 247, 220);
}

#settings-title {
    position: absolute;
    left: 22px;
    top: 40px;
    font-size: 38px;
    font-weight: bold;
    letter-spacing: 4px;
    color: #f3fffd;
}

#settings-subtitle {
    position: absolute;
    left: 24px;
    top: 84px;
    width: 560px;
    font-size: 11px;
    letter-spacing: 0.5px;
    color: rgba(212, 255, 250, 164);
}

#settings-focus-card {
    position: absolute;
    left: 26px;
    top: 160px;
    width: 618px;
    height: 86px;
}

#settings-focus-code {
    position: absolute;
    left: 16px;
    top: 24px;
    width: 48px;
    font-size: 18px;
    font-weight: bold;
    color: #92fff6;
}

#settings-focus-copy-group {
    position: absolute;
    left: 86px;
    top: 16px;
    width: 504px;
    height: 54px;
}

#settings-focus-title {
    position: absolute;
    left: 0;
    top: 0;
    font-size: 15px;
    font-weight: bold;
    letter-spacing: 1.8px;
    color: #f0fffd;
}

#settings-focus-copy {
    position: absolute;
    left: 0;
    top: 26px;
    width: 500px;
    font-size: 11px;
    letter-spacing: 0.4px;
    color: rgba(212, 255, 250, 170);
}

#settings-section-tag {
    position: absolute;
    left: 26px;
    top: 268px;
    font-size: 15px;
    font-weight: bold;
    letter-spacing: 3px;
    color: #8ffff6;
}

#settings-system-chip {
    position: absolute;
    left: 534px;
    top: 270px;
    font-size: 11px;
    letter-spacing: 2.2px;
    color: rgba(206, 255, 251, 166);
}

#settings-rows {
    position: absolute;
    left: 26px;
    top: 304px;
    width: 618px;
    height: 258px;
}

.settings-row {
    position: relative;
    display: block;
    width: 618px;
    height: 52px;
    margin-bottom: 14px;
    background-color: rgba(8, 22, 24, 128);
    border: 1dp rgba(93, 255, 241, 44);
    color: #efffff;
}

.settings-row-slider {
    height: 72px;
}

.settings-row-beam {
    position: absolute;
    left: -1dp;
    top: -1dp;
    width: 4px;
    height: 100%;
    background-color: rgba(98, 255, 243, 62);
}

.settings-row-code {
    position: absolute;
    left: 16px;
    top: 15px;
    width: 36px;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 1px;
    color: rgba(184, 255, 248, 190);
}

.settings-row-label {
    position: absolute;
    left: 78px;
    top: 12px;
    font-size: 18px;
    font-weight: bold;
    letter-spacing: 1.8px;
    color: #efffff;
}

.settings-row-value {
    position: absolute;
    right: 18px;
    top: 14px;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 2.2px;
    color: rgba(216, 255, 251, 174);
}

.settings-row.selected {
    background-color: rgba(57, 197, 187, 48);
    border: 1dp rgba(125, 255, 245, 172);
    color: #f8ffff;
}

.settings-row.selected .settings-row-beam {
    background-color: rgba(125, 255, 245, 214);
    animation: 1.5s infinite alternate signal-breathe;
}

.settings-row.selected .settings-row-code,
.settings-row.selected .settings-row-value {
    color: #f4fffd;
}

.settings-slider {
    position: absolute;
    left: 78px;
    right: 126px;
    bottom: 12px;
    height: 16px;
}

input.settings-slider {
    width: auto;
    background: transparent;
}

input.settings-slider slidertrack {
    margin-top: 5dp;
    height: 4dp;
    background-color: rgba(24, 46, 51, 238);
    border: 0;
}

input.settings-slider sliderprogress {
    margin-top: 5dp;
    height: 4dp;
    background-color: #39c5bb;
}

.settings-row.selected input.settings-slider slidertrack {
    background-color: rgba(235, 255, 252, 48);
}

.settings-row.selected input.settings-slider sliderprogress {
    background-color: #b8fff9;
}

input.settings-slider sliderbar {
    width: 8dp;
    height: 14dp;
    margin-left: -4dp;
    margin-right: -4dp;
    margin-top: 0;
    background-color: #39c5bb;
    border: 0;
    border-radius: 0;
}

.settings-row.selected input.settings-slider sliderbar {
    background-color: #f4fffd;
}

input.settings-slider sliderarrowdec,
input.settings-slider sliderarrowinc {
    display: none;
}

.settings-row-back-value {
    top: 15px;
}

#settings-side-panel {
    position: absolute;
    right: 26px;
    top: 160px;
    width: 412px;
    height: 402px;
}

#settings-side-line {
    position: absolute;
    left: 22px;
    top: 22px;
    width: 86px;
    height: 2px;
    background-color: rgba(114, 255, 245, 196);
}

#settings-side-label {
    position: absolute;
    left: 22px;
    top: 38px;
    font-size: 11px;
    letter-spacing: 3px;
    color: rgba(154, 255, 247, 220);
}

#settings-side-title {
    position: absolute;
    left: 22px;
    top: 68px;
    width: 332px;
    font-size: 24px;
    font-weight: bold;
    letter-spacing: 1.6px;
    color: #f3fffd;
}

#settings-side-copy {
    position: absolute;
    left: 22px;
    top: 146px;
    width: 350px;
    font-size: 12px;
    letter-spacing: 0.5px;
    color: rgba(216, 255, 251, 164);
}

#story-advance-target {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

#story-bg-art {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

#story-dialogue-box {
    position: absolute;
    left: 40px;
    bottom: 40px;
    width: 1200px;
    height: 200px;
    background-color: rgba(0, 0, 0, 168);
    border: 1dp rgba(232, 236, 244, 180);
}

#story-speaker-name {
    position: absolute;
    left: 24px;
    top: 14px;
    width: 1152px;
    font-size: 18px;
    letter-spacing: 1px;
    color: #ffffff;
    text-align: center;
}

#story-portrait-frame {
    position: absolute;
    left: 16px;
    top: 52px;
    width: 112px;
    height: 112px;
    background-color: rgba(255, 255, 255, 14);
    border: 1dp rgba(222, 232, 246, 96);
}

#story-portrait-img {
    position: absolute;
    left: 0;
    top: 0;
    width: 112px;
    height: 112px;
}

#story-dialogue-copy {
    position: absolute;
    left: 154px;
    top: 60px;
    width: 1018px;
    height: 108px;
}

#story-dialogue-text {
    font-size: 24px;
    line-height: 1.35em;
    color: #f4f6fb;
}

#story-dialogue-box.story-no-portrait #story-portrait-frame {
    display: none;
}

#story-dialogue-box.story-no-portrait #story-dialogue-copy {
    left: 28px;
    width: 1144px;
}

#story-dialogue-box.story-no-speaker #story-dialogue-copy {
    top: 34px;
    height: 134px;
}

#pause-shell,
#load-shell {
    position: absolute;
    left: 14.85%;
    right: 14.85%;
    top: 8.35%;
    bottom: 8.35%;
    background-color: rgba(4, 12, 14, 226);
    border: 1dp rgba(93, 255, 241, 104);
}

#pause-title-shell,
#load-title-shell {
    position: absolute;
    left: 26px;
    top: 24px;
    width: 848px;
    height: 110px;
    background-color: rgba(6, 18, 21, 198);
    border: 1dp rgba(93, 255, 241, 90);
}

#pause-kicker,
#load-kicker {
    position: absolute;
    left: 22px;
    top: 16px;
    font-size: 12px;
    letter-spacing: 2.8px;
    color: rgba(161, 255, 247, 220);
}

#pause-title,
#load-title {
    position: absolute;
    left: 22px;
    top: 40px;
    font-size: 36px;
    font-weight: bold;
    letter-spacing: 4px;
    color: #f3fffd;
}

#pause-subtitle,
#load-subtitle {
    position: absolute;
    left: 22px;
    top: 82px;
    width: 780px;
    font-size: 11px;
    letter-spacing: 0.4px;
    color: rgba(212, 255, 250, 164);
}

#pause-buttons {
    position: absolute;
    left: 150px;
    top: 184px;
    width: 600px;
    height: 318px;
}

.pause-button,
.load-footer-button,
.pause-confirm-button {
    display: block;
    width: 100%;
    height: 54px;
    margin-bottom: 14px;
    background-color: rgba(8, 22, 24, 128);
    border: 1dp rgba(93, 255, 241, 44);
    color: #efffff;
    font-size: 18px;
    font-weight: bold;
    letter-spacing: 1.8px;
    text-align: center;
    line-height: 54px;
}

.pause-button.is-selected,
.load-footer-button.is-selected,
.pause-confirm-button.is-selected {
    background-color: rgba(57, 197, 187, 48);
    border: 1dp rgba(125, 255, 245, 172);
    color: #f8ffff;
}

#pause-notice {
    position: absolute;
    left: 150px;
    bottom: 58px;
    width: 600px;
    height: 24px;
    font-size: 12px;
    letter-spacing: 0.4px;
    color: #ffd58a;
    text-align: center;
}

#pause-confirm,
#load-confirm {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(4, 8, 14, 198);
    display: none;
}

#pause-confirm.is-visible,
#load-confirm.is-visible {
    display: block;
}

#pause-confirm-card,
#load-confirm-card {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 560px;
    height: 312px;
    margin-left: -280px;
    margin-top: -156px;
    background-color: rgba(10, 20, 42, 242);
    border: 1dp rgba(80, 228, 255, 212);
}

#pause-confirm-title,
#load-confirm-title {
    position: absolute;
    left: 32px;
    top: 28px;
    width: 496px;
    font-size: 28px;
    font-weight: bold;
    letter-spacing: 1.8px;
    color: #f4fffd;
}

#pause-confirm-body,
#load-confirm-body {
    position: absolute;
    left: 32px;
    top: 86px;
    width: 496px;
    font-size: 16px;
    line-height: 1.45em;
    color: rgba(232, 244, 252, 218);
}

#pause-confirm-actions,
#load-confirm-actions {
    position: absolute;
    left: 32px;
    bottom: 28px;
    width: 496px;
    height: 54px;
}

#pause-confirm-cancel,
#load-confirm-cancel {
    position: absolute;
    left: 0;
    top: 0;
    width: 228px;
}

#pause-confirm-confirm,
#load-confirm-delete {
    position: absolute;
    right: 0;
    top: 0;
    width: 228px;
}

#load-slot-list {
    position: absolute;
    left: 54px;
    top: 174px;
    width: 792px;
    height: 340px;
}

.load-slot-button {
    position: relative;
    display: block;
    width: 792px;
    height: 58px;
    margin-bottom: 12px;
    background-color: rgba(8, 22, 24, 128);
    border: 1dp rgba(93, 255, 241, 44);
}

.load-slot-button.is-selected {
    background-color: rgba(57, 197, 187, 48);
    border: 1dp rgba(125, 255, 245, 172);
}

.load-slot-kind {
    position: absolute;
    left: 16px;
    top: 15px;
    width: 120px;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 2px;
    color: rgba(255, 230, 154, 232);
}

.load-slot-label {
    position: absolute;
    left: 160px;
    top: 11px;
    width: 460px;
    font-size: 18px;
    font-weight: bold;
    letter-spacing: 1.2px;
    color: #efffff;
}

.load-slot-time {
    position: absolute;
    left: 160px;
    top: 34px;
    width: 520px;
    font-size: 11px;
    letter-spacing: 0.4px;
    color: rgba(216, 255, 251, 170);
}

#load-empty-state {
    position: absolute;
    left: 54px;
    top: 314px;
    width: 792px;
    font-size: 18px;
    letter-spacing: 1px;
    color: rgba(236, 246, 252, 220);
    text-align: center;
    display: none;
}

#load-empty-state.is-visible {
    display: block;
}

#load-footer {
    position: absolute;
    left: 214px;
    bottom: 50px;
    width: 472px;
    height: 54px;
}

#load-notice {
    position: absolute;
    left: 150px;
    bottom: 18px;
    width: 600px;
    height: 20px;
    font-size: 12px;
    letter-spacing: 0.4px;
    color: #ffd58a;
    text-align: center;
}

#load-footer-delete {
    position: absolute;
    left: 0;
    top: 0;
    width: 220px;
}

#load-footer-back {
    position: absolute;
    right: 0;
    top: 0;
    width: 220px;
}

#load-footer-delete.is-disabled {
    background-color: rgba(18, 24, 30, 128);
    border: 1dp rgba(98, 112, 124, 48);
    color: rgba(168, 180, 192, 148);
}
