<rml>
<head>
    <title>Story</title>
    <link type="text/rcss" href="front_ui_shared.rcss"/>
</head>
<body>
    <div id="story-advance-target">
        <div id="story-bg-color" class="is-hidden"></div>
        <img id="story-bg-art-prev" src="" class="is-hidden"/>
        <img id="story-bg-art" src="" class="is-hidden"/>
        <div id="story-dialogue-box">
            <div id="story-speaker-name"></div>
            <div id="story-portrait-frame">
                <img id="story-portrait-img" src="" class="is-hidden"/>
            </div>
            <div id="story-dialogue-copy">
                <div id="story-dialogue-text"></div>
            </div>
        </div>
    </div>
</body>
</rml>
