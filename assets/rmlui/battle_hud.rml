<rml>
<head>
    <title>Battle HUD Smoke</title>
    <link type="text/rcss" href="battle_hud.rcss" />
</head>
<body>
    <div id="stage">
        <div class="boss-shell">
            <div class="boss-fill" id="boss-fill"></div>
            <div class="boss-name" id="boss-name">LYOO</div>
            <div class="boss-percent" id="boss-percent">HP 100%</div>
            <div class="boss-orbs" id="boss-orbs">
                <div class="boss-orb" id="boss-orb-1"></div>
                <div class="boss-orb" id="boss-orb-2"></div>
                <div class="boss-orb" id="boss-orb-3"></div>
                <div class="boss-orb" id="boss-orb-4"></div>
                <div class="boss-orb" id="boss-orb-5"></div>
                <div class="boss-orb" id="boss-orb-6"></div>
            </div>
        </div>

        <div class="turn-stack">
            <div class="turn-card turn-card-1" id="turn-card-1">
                <div class="turn-card-accent" id="turn-accent-1"></div>
                <div class="turn-portrait" id="turn-portrait-1"></div>
            </div>
            <div class="turn-card turn-card-2" id="turn-card-2">
                <div class="turn-card-accent" id="turn-accent-2"></div>
                <div class="turn-portrait" id="turn-portrait-2"></div>
            </div>
            <div class="turn-card turn-card-3" id="turn-card-3">
                <div class="turn-card-accent" id="turn-accent-3"></div>
                <div class="turn-portrait" id="turn-portrait-3"></div>
            </div>
            <div class="turn-card turn-card-4" id="turn-card-4">
                <div class="turn-card-accent" id="turn-accent-4"></div>
                <div class="turn-portrait" id="turn-portrait-4"></div>
            </div>
            <div class="turn-card turn-card-5" id="turn-card-5">
                <div class="turn-card-accent" id="turn-accent-5"></div>
                <div class="turn-portrait" id="turn-portrait-5"></div>
            </div>
        </div>

        <div class="party-rack" id="party-rack">
            <div class="unit-card unit-card-1" id="unit-card-1">
                <div class="unit-portrait" id="unit-portrait-1"></div>
                <div class="unit-fade-left"></div>
                <div class="unit-fade-right"></div>
                <div class="unit-fade-bottom"></div>
                <div class="unit-name" id="unit-name-1">IROHA</div>
                <div class="unit-orbs">
                    <div class="unit-orb" id="unit-1-orb-1"></div>
                    <div class="unit-orb" id="unit-1-orb-2"></div>
                    <div class="unit-orb" id="unit-1-orb-3"></div>
                    <div class="unit-orb" id="unit-1-orb-4"></div>
                    <div class="unit-orb" id="unit-1-orb-5"></div>
                    <div class="unit-orb" id="unit-1-orb-6"></div>
                </div>
                <div class="unit-power" id="unit-hp-text-1">72 / 72</div>
                <div class="hp-track hp-track-wide"><div class="hp-fill" id="unit-hp-fill-1"></div></div>
            </div>

            <div class="unit-card unit-card-2" id="unit-card-2">
                <div class="unit-portrait" id="unit-portrait-2"></div>
                <div class="unit-fade-left"></div>
                <div class="unit-fade-right"></div>
                <div class="unit-fade-bottom"></div>
                <div class="unit-name" id="unit-name-2">KAGUYA</div>
                <div class="unit-orbs">
                    <div class="unit-orb" id="unit-2-orb-1"></div>
                    <div class="unit-orb" id="unit-2-orb-2"></div>
                    <div class="unit-orb" id="unit-2-orb-3"></div>
                    <div class="unit-orb" id="unit-2-orb-4"></div>
                    <div class="unit-orb" id="unit-2-orb-5"></div>
                    <div class="unit-orb" id="unit-2-orb-6"></div>
                </div>
                <div class="unit-power" id="unit-hp-text-2">54 / 54</div>
                <div class="hp-track hp-track-wide"><div class="hp-fill" id="unit-hp-fill-2"></div></div>
            </div>

            <div class="unit-card unit-card-3" id="unit-card-3">
                <div class="unit-portrait" id="unit-portrait-3"></div>
                <div class="unit-fade-left"></div>
                <div class="unit-fade-right"></div>
                <div class="unit-fade-bottom"></div>
                <div class="unit-name" id="unit-name-3">MIKU</div>
                <div class="unit-orbs">
                    <div class="unit-orb" id="unit-3-orb-1"></div>
                    <div class="unit-orb" id="unit-3-orb-2"></div>
                    <div class="unit-orb" id="unit-3-orb-3"></div>
                    <div class="unit-orb" id="unit-3-orb-4"></div>
                    <div class="unit-orb" id="unit-3-orb-5"></div>
                    <div class="unit-orb" id="unit-3-orb-6"></div>
                </div>
                <div class="unit-power" id="unit-hp-text-3">40 / 40</div>
                <div class="hp-track hp-track-wide"><div class="hp-fill" id="unit-hp-fill-3"></div></div>
            </div>

            <div class="unit-card unit-card-4" id="unit-card-4">
                <div class="unit-portrait" id="unit-portrait-4"></div>
                <div class="unit-fade-left"></div>
                <div class="unit-fade-right"></div>
                <div class="unit-fade-bottom"></div>
                <div class="unit-name" id="unit-name-4">CUPCAKKE</div>
                <div class="unit-orbs">
                    <div class="unit-orb" id="unit-4-orb-1"></div>
                    <div class="unit-orb" id="unit-4-orb-2"></div>
                    <div class="unit-orb" id="unit-4-orb-3"></div>
                    <div class="unit-orb" id="unit-4-orb-4"></div>
                    <div class="unit-orb" id="unit-4-orb-5"></div>
                    <div class="unit-orb" id="unit-4-orb-6"></div>
                </div>
                <div class="unit-power" id="unit-hp-text-4">60 / 60</div>
                <div class="hp-track hp-track-wide"><div class="hp-fill" id="unit-hp-fill-4"></div></div>
            </div>
        </div>

        <div class="action-button action-button-skill" id="action-skill">
            <div class="action-button-core">
                <img class="action-button-icon action-button-icon-stacked" src="icons/stacked-arrow-black.svg" />
            </div>
            <div class="action-button-key">E</div>
            <div class="action-button-label">SKILL</div>
        </div>

        <div class="action-button action-button-standard" id="action-standard">
            <div class="action-button-core">
                <img class="action-button-icon action-button-icon-single" src="icons/arrow-black.svg" />
            </div>
            <div class="action-button-key">Q</div>
            <div class="action-button-label">STANDARD</div>
        </div>

        <div class="battle-toast" id="battle-toast"></div>
    </div>
</body>
</rml>
