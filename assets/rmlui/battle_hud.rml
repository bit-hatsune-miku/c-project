<rml>
<head>
    <title>Battle HUD</title>
    <link type="text/rcss" href="battle_hud.rcss" />
</head>
<body>
    <div id="hud-root">
        <div id="hud-edge-layer">
            <div class="turn-rail" id="turn-rail">
                <div class="turn-card" id="turn-card-1">
                    <div class="turn-card-shell"></div>
                    <div class="turn-card-stripe"></div>
                    <div class="turn-card-inner">
                        <div class="turn-portrait-frame">
                            <div class="turn-portrait" id="turn-portrait-1"></div>
                        </div>
                        <div class="turn-badge">
                            <div class="turn-badge-value" id="turn-value-1">12</div>
                        </div>
                    </div>
                </div>
                <div class="turn-card" id="turn-card-2">
                    <div class="turn-card-shell"></div>
                    <div class="turn-card-stripe"></div>
                    <div class="turn-card-inner">
                        <div class="turn-portrait-frame">
                            <div class="turn-portrait" id="turn-portrait-2"></div>
                        </div>
                        <div class="turn-badge">
                            <div class="turn-badge-value" id="turn-value-2">24</div>
                        </div>
                    </div>
                </div>
                <div class="turn-card" id="turn-card-3">
                    <div class="turn-card-shell"></div>
                    <div class="turn-card-stripe"></div>
                    <div class="turn-card-inner">
                        <div class="turn-portrait-frame">
                            <div class="turn-portrait" id="turn-portrait-3"></div>
                        </div>
                        <div class="turn-badge">
                            <div class="turn-badge-value" id="turn-value-3">37</div>
                        </div>
                    </div>
                </div>
                <div class="turn-card" id="turn-card-4">
                    <div class="turn-card-shell"></div>
                    <div class="turn-card-stripe"></div>
                    <div class="turn-card-inner">
                        <div class="turn-portrait-frame">
                            <div class="turn-portrait" id="turn-portrait-4"></div>
                        </div>
                        <div class="turn-badge">
                            <div class="turn-badge-value" id="turn-value-4">51</div>
                        </div>
                    </div>
                </div>
                <div class="turn-card" id="turn-card-5">
                    <div class="turn-card-shell"></div>
                    <div class="turn-card-stripe"></div>
                    <div class="turn-card-inner">
                        <div class="turn-portrait-frame">
                            <div class="turn-portrait" id="turn-portrait-5"></div>
                        </div>
                        <div class="turn-badge">
                            <div class="turn-badge-value" id="turn-value-5">68</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="boss-band" id="boss-band">
                <div class="boss-name" id="boss-name">JIAFEI</div>
                <div class="boss-meter-shell" id="boss-meter-shell">
                    <div class="boss-meter-lane">
                        <div class="boss-meter-trail" id="boss-trail"></div>
                        <div class="boss-meter-fill" id="boss-fill"></div>
                        <div class="boss-meter-readout">
                            <div class="boss-readout" id="boss-readout">312 / 420 HP</div>
                            <div class="boss-percent" id="boss-percent">74%</div>
                        </div>
                    </div>
                </div>
                <div class="boss-hit-flash" id="boss-hit-flash"></div>
            </div>

            <div class="party-rack" id="party-rack">
                <div class="unit-card" id="unit-card-1">
                    <div class="unit-ult">
                        <div class="unit-ult-fill" id="unit-ult-fill-1"></div>
                        <div class="unit-ult-sheen" id="unit-ult-sheen-1"></div>
                        <div class="unit-ult-rim"></div>
                        <div class="unit-ult-core" id="unit-ult-text-1">2 / 3</div>
                    </div>
                    <div class="unit-icon" id="unit-icon-1"></div>
                    <div class="unit-hp-shell">
                        <div class="unit-hp-lane">
                            <div class="unit-hp-trail" id="unit-hp-trail-1"></div>
                            <div class="unit-hp-fill" id="unit-hp-fill-1"></div>
                            <div class="unit-shield-stroke">
                                <div class="unit-shield-line unit-shield-line-top" id="unit-shield-top-1"></div>
                                <div class="unit-shield-line unit-shield-line-bottom" id="unit-shield-bottom-1"></div>
                                <div class="unit-shield-line unit-shield-line-left" id="unit-shield-left-1"></div>
                                <div class="unit-shield-line unit-shield-line-right" id="unit-shield-right-1"></div>
                            </div>
                            <div class="unit-hp-text" id="unit-hp-text-1">32 / 40</div>
                        </div>
                    </div>
                    <div class="unit-shield-badge" id="unit-shield-badge-1">
                        <div class="unit-shield-icon"></div>
                        <div class="unit-shield-value" id="unit-shield-value-1">8</div>
                    </div>
                    <div class="unit-hit-flash" id="unit-hit-flash-1"></div>
                </div>

                <div class="unit-card" id="unit-card-2">
                    <div class="unit-ult">
                        <div class="unit-ult-fill" id="unit-ult-fill-2"></div>
                        <div class="unit-ult-sheen" id="unit-ult-sheen-2"></div>
                        <div class="unit-ult-rim"></div>
                        <div class="unit-ult-core" id="unit-ult-text-2">3 / 4</div>
                    </div>
                    <div class="unit-icon" id="unit-icon-2"></div>
                    <div class="unit-hp-shell">
                        <div class="unit-hp-lane">
                            <div class="unit-hp-trail" id="unit-hp-trail-2"></div>
                            <div class="unit-hp-fill" id="unit-hp-fill-2"></div>
                            <div class="unit-shield-stroke">
                                <div class="unit-shield-line unit-shield-line-top" id="unit-shield-top-2"></div>
                                <div class="unit-shield-line unit-shield-line-bottom" id="unit-shield-bottom-2"></div>
                                <div class="unit-shield-line unit-shield-line-left" id="unit-shield-left-2"></div>
                                <div class="unit-shield-line unit-shield-line-right" id="unit-shield-right-2"></div>
                            </div>
                            <div class="unit-hp-text" id="unit-hp-text-2">47 / 60</div>
                        </div>
                    </div>
                    <div class="unit-shield-badge" id="unit-shield-badge-2">
                        <div class="unit-shield-icon"></div>
                        <div class="unit-shield-value" id="unit-shield-value-2">14</div>
                    </div>
                    <div class="unit-hit-flash" id="unit-hit-flash-2"></div>
                </div>

                <div class="unit-card" id="unit-card-3">
                    <div class="unit-ult">
                        <div class="unit-ult-fill" id="unit-ult-fill-3"></div>
                        <div class="unit-ult-sheen" id="unit-ult-sheen-3"></div>
                        <div class="unit-ult-rim"></div>
                        <div class="unit-ult-core" id="unit-ult-text-3">1 / 3</div>
                    </div>
                    <div class="unit-icon" id="unit-icon-3"></div>
                    <div class="unit-hp-shell">
                        <div class="unit-hp-lane">
                            <div class="unit-hp-trail" id="unit-hp-trail-3"></div>
                            <div class="unit-hp-fill" id="unit-hp-fill-3"></div>
                            <div class="unit-shield-stroke">
                                <div class="unit-shield-line unit-shield-line-top" id="unit-shield-top-3"></div>
                                <div class="unit-shield-line unit-shield-line-bottom" id="unit-shield-bottom-3"></div>
                                <div class="unit-shield-line unit-shield-line-left" id="unit-shield-left-3"></div>
                                <div class="unit-shield-line unit-shield-line-right" id="unit-shield-right-3"></div>
                            </div>
                            <div class="unit-hp-text" id="unit-hp-text-3">74 / 80</div>
                        </div>
                    </div>
                    <div class="unit-shield-badge" id="unit-shield-badge-3">
                        <div class="unit-shield-icon"></div>
                        <div class="unit-shield-value" id="unit-shield-value-3">6</div>
                    </div>
                    <div class="unit-hit-flash" id="unit-hit-flash-3"></div>
                </div>

                <div class="unit-card" id="unit-card-4">
                    <div class="unit-ult">
                        <div class="unit-ult-fill" id="unit-ult-fill-4"></div>
                        <div class="unit-ult-sheen" id="unit-ult-sheen-4"></div>
                        <div class="unit-ult-rim"></div>
                        <div class="unit-ult-core" id="unit-ult-text-4">4 / 5</div>
                    </div>
                    <div class="unit-icon" id="unit-icon-4"></div>
                    <div class="unit-hp-shell">
                        <div class="unit-hp-lane">
                            <div class="unit-hp-trail" id="unit-hp-trail-4"></div>
                            <div class="unit-hp-fill" id="unit-hp-fill-4"></div>
                            <div class="unit-shield-stroke">
                                <div class="unit-shield-line unit-shield-line-top" id="unit-shield-top-4"></div>
                                <div class="unit-shield-line unit-shield-line-bottom" id="unit-shield-bottom-4"></div>
                                <div class="unit-shield-line unit-shield-line-left" id="unit-shield-left-4"></div>
                                <div class="unit-shield-line unit-shield-line-right" id="unit-shield-right-4"></div>
                            </div>
                            <div class="unit-hp-text" id="unit-hp-text-4">39 / 52</div>
                        </div>
                    </div>
                    <div class="unit-shield-badge" id="unit-shield-badge-4">
                        <div class="unit-shield-icon"></div>
                        <div class="unit-shield-value" id="unit-shield-value-4">3</div>
                    </div>
                    <div class="unit-hit-flash" id="unit-hit-flash-4"></div>
                </div>
            </div>
        </div>

        <div id="safe-stage">
            <div class="battle-combo" id="battle-combo">
                <div class="battle-combo-count" id="battle-combo-count">0</div>
                <div class="battle-combo-bonus" id="battle-combo-bonus">+0% DMG</div>
                <div class="battle-combo-meter">
                    <div class="battle-combo-fill" id="battle-combo-fill"></div>
                </div>
            </div>

            <div class="battle-judgement" id="battle-judgement">
                <div class="battle-judgement-word" id="battle-judgement-word"></div>
                <div class="battle-judgement-reward" id="battle-judgement-reward"></div>
            </div>

            <div class="battle-tutorial" id="battle-tutorial">
                <div class="battle-tutorial-card">
                    <div class="battle-tutorial-layout">
                        <div class="battle-tutorial-portrait" id="battle-tutorial-portrait"></div>
                        <div class="battle-tutorial-copy">
                            <div class="battle-tutorial-speaker" id="battle-tutorial-speaker">Lyoo</div>
                            <div class="battle-tutorial-text" id="battle-tutorial-text"></div>
                            <div class="battle-tutorial-dismiss-hint">PRESS BACKSPACE TO DISMISS</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="battle-rhythm" id="battle-rhythm">
                <div class="battle-rhythm-kicker">SKILL MINIGAME</div>
                <div class="battle-rhythm-title" id="battle-rhythm-title"></div>
                <div class="battle-rhythm-body" id="battle-rhythm-body"></div>
                <div class="battle-rhythm-lane">
                    <div class="battle-rhythm-window"></div>
                    <div class="battle-rhythm-pulse" id="battle-rhythm-pulse"></div>
                </div>
            </div>

            <div class="battle-result" id="battle-result">
                <div class="battle-result-dim" id="battle-result-dim"></div>
                <div class="battle-result-focus">
                    <div class="battle-result-kicker" id="battle-result-kicker">BATTLE RESOLVED</div>
                    <div class="battle-result-word-shell" id="battle-result-word-shell">
                        <div class="battle-result-word" id="battle-result-word"></div>
                    </div>
                    <button class="battle-result-button" id="battle-result-button">
                        <div class="battle-result-button-stage" id="battle-result-button-stage">
                            <div class="battle-result-button-shell"></div>
                            <div class="battle-result-button-content">
                                <div class="battle-result-button-accent"></div>
                                <div class="battle-result-button-code">01</div>
                                <div class="battle-result-button-main">
                                    <div class="battle-result-button-label" id="battle-result-button-label">CONTINUE</div>
                                    <div class="battle-result-button-sub" id="battle-result-button-sub">Advance to the next story beat.</div>
                                </div>
                                <div class="battle-result-button-tail"></div>
                            </div>
                        </div>
                    </button>
                </div>
            </div>

            <div class="battle-vs-intro" id="battle-vs-intro">
                <div class="battle-vs-intro-void" id="battle-vs-intro-void"></div>
                <div class="battle-vs-intro-splitter" id="battle-vs-intro-splitter"></div>

                <div class="battle-vs-card left" id="battle-vs-card-left">
                    <div class="battle-vs-card-body main"></div>
                    <div class="battle-vs-card-body tail"></div>
                    <div class="battle-vs-card-rim main"></div>
                    <div class="battle-vs-card-rim tail"></div>
                    <div class="battle-vs-card-glow"></div>
                    <div class="battle-vs-card-stripe one"></div>
                    <div class="battle-vs-card-stripe two"></div>
                    <div class="battle-vs-card-inner">
                        <div class="battle-vs-portrait-frame">
                            <div class="battle-vs-portrait-stage">
                                <div class="battle-vs-portrait-shadow"></div>
                                <div class="battle-vs-portrait-image" id="battle-vs-portrait-left"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="battle-vs-card right" id="battle-vs-card-right">
                    <div class="battle-vs-card-body main"></div>
                    <div class="battle-vs-card-body tail"></div>
                    <div class="battle-vs-card-rim main"></div>
                    <div class="battle-vs-card-rim tail"></div>
                    <div class="battle-vs-card-glow"></div>
                    <div class="battle-vs-card-stripe one"></div>
                    <div class="battle-vs-card-stripe two"></div>
                    <div class="battle-vs-card-inner">
                        <div class="battle-vs-portrait-frame">
                            <div class="battle-vs-portrait-stage">
                                <div class="battle-vs-portrait-shadow"></div>
                                <div class="battle-vs-portrait-image" id="battle-vs-portrait-right"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="battle-vs-name-stage right" id="battle-vs-name-stage-right">
                    <div class="battle-vs-name-word" id="battle-vs-name-word-right"></div>
                </div>

                <div class="battle-vs-name-stage left" id="battle-vs-name-stage-left">
                    <div class="battle-vs-name-word" id="battle-vs-name-word-left"></div>
                </div>

                <div class="battle-vs-cluster" id="battle-vs-cluster">
                    <div class="battle-vs-hit-anchor v">
                        <div class="battle-vs-letter v" id="battle-vs-letter-v">V</div>
                    </div>
                    <div class="battle-vs-hit-anchor s">
                        <div class="battle-vs-letter s" id="battle-vs-letter-s">S</div>
                    </div>
                </div>
            </div>

            <div class="battle-pause" id="battle-pause">
                <div class="battle-pause-shell" id="battle-pause-shell">
                    <div class="battle-pause-kicker" id="battle-pause-kicker">IN BATTLE</div>
                    <div class="battle-pause-title" id="battle-pause-title">PAUSED</div>
                    <div class="battle-pause-hint" id="battle-pause-hint">ESC TO RESUME. SETTINGS MATCH THE MAIN APP.</div>
                    <div class="battle-pause-menu visible" id="battle-pause-menu">
                        <div class="battle-pause-button selected" id="battle-pause-continue">CONTINUE</div>
                        <div class="battle-pause-button" id="battle-pause-settings-button">SETTINGS</div>
                        <div class="battle-pause-button" id="battle-pause-exit">EXIT TO MAIN MENU</div>
                    </div>
                    <div class="battle-pause-settings" id="battle-pause-settings">
                        <div class="battle-settings-row selected" id="battle-settings-row-display">
                            <div class="battle-settings-label">DISPLAY MODE</div>
                            <div class="battle-settings-value" id="battle-settings-display-value">WINDOWED</div>
                        </div>
                        <div class="battle-settings-row" id="battle-settings-row-voice">
                            <div class="battle-settings-label">VOICE VOLUME</div>
                            <div class="battle-settings-value" id="battle-settings-voice-value">82%</div>
                            <input class="battle-settings-slider" id="battle-settings-voice-slider" type="range" min="0" max="100" step="5" value="82" />
                        </div>
                        <div class="battle-settings-row" id="battle-settings-row-text">
                            <div class="battle-settings-label">TEXT SPEED</div>
                            <div class="battle-settings-value" id="battle-settings-text-value">42 CPS</div>
                            <input class="battle-settings-slider" id="battle-settings-text-slider" type="range" min="18" max="90" step="6" value="42" />
                        </div>
                        <div class="battle-settings-row" id="battle-settings-row-back">
                            <div class="battle-settings-label">BACK</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="battle-hint" id="battle-hint"></div>
            <div class="battle-toast" id="battle-toast"></div>
        </div>
    </div>
</body>
</rml>
