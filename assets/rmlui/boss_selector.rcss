body {
    margin: 0;
    width: 100%;
    height: 100%;
    font-family: "DejaVu Sans";
    color: #eafcff;
    background-color: transparent;
}

#selector-root {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: #06131a;
}

#selector-background-glow {
    position: absolute;
    left: -12%;
    top: -18%;
    width: 76%;
    height: 78%;
    border-radius: 520px;
    background-color: rgba(24, 209, 255, 28);
    box-shadow: 0 0 240px rgba(24, 209, 255, 0.18);
}

#selector-background-grid {
    position: absolute;
    left: -8%;
    top: -12%;
    width: 120%;
    height: 140%;
    transform: skewX(-12deg);
    background-color: rgba(0, 0, 0, 0);
    decorator: linear-gradient(to bottom, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0)) border-box;
    border: 1px rgba(101, 228, 255, 22);
}

#idol-rank-panel {
    position: absolute;
    left: 30px;
    top: 26px;
    width: 204px;
    padding: 18px 22px 18px 22px;
    background-color: rgba(7, 23, 31, 204);
    border: 1px rgba(116, 246, 255, 110);
    box-shadow: 0 0 22px rgba(24, 209, 255, 0.16);
}

.rank-kicker {
    color: #8bdde6;
    font-size: 14px;
    letter-spacing: 2px;
}

.rank-value {
    margin-top: 8px;
    color: #ffffff;
    font-size: 42px;
    font-weight: bold;
}

.rank-caption {
    margin-top: 4px;
    color: #96b8be;
    font-size: 15px;
}

#detail-panel {
    position: absolute;
    left: auto;
    right: 28px;
    top: 142px;
    width: 332px;
    height: 498px;
    padding: 20px 22px 22px 22px;
    background-color: rgba(7, 22, 29, 226);
    border: 1px rgba(97, 228, 255, 92);
    box-shadow: 0 0 28px rgba(24, 209, 255, 0.11);
    opacity: 0;
}

.detail-border {
    position: absolute;
    right: 18px;
    top: 18px;
    width: 74px;
    height: 5px;
    background-color: rgba(120, 246, 255, 160);
}

.detail-kicker {
    color: #87d6de;
    font-size: 14px;
    letter-spacing: 3px;
}

.detail-portrait {
    margin-top: 18px;
    width: 100%;
    height: 218px;
    background-color: rgba(9, 28, 36, 210);
    border: 1px rgba(116, 246, 255, 70);
    overflow: hidden;
    decorator: none;
}

.detail-boss-name {
    margin-top: 16px;
    color: #ffffff;
    font-size: 28px;
    font-weight: bold;
}

.detail-battle-name {
    margin-top: 5px;
    color: #77d6df;
    font-size: 18px;
}

.detail-description {
    margin-top: 16px;
    color: #b4d1d6;
    font-size: 15px;
    line-height: 22px;
    white-space: normal;
}

.detail-meta {
    margin-top: 18px;
}

.detail-meta-row {
    margin-top: 12px;
}

.detail-meta-label {
    color: #79ccd4;
    font-size: 13px;
    letter-spacing: 2px;
}

.detail-meta-value {
    margin-top: 4px;
    color: #f2fcff;
    font-size: 16px;
}

#selector-stage {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

#selector-heading {
    position: absolute;
    left: 80px;
    top: 40px;
    width: 650px;
}

.selector-title {
    color: #f4feff;
    font-size: 36px;
    font-weight: bold;
}

.selector-subtitle {
    margin-top: 6px;
    color: #7ab9c1;
    font-size: 16px;
}

#boss-track {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.boss-card-shell {
    position: absolute;
    width: 248px;
    height: 434px;
    transform-origin: 50% 50%;
}

.boss-card-frame {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.boss-card-cap-left,
.boss-card-cap-right {
    position: absolute;
    top: 26px;
    width: 34px;
    height: 382px;
    background-color: rgba(10, 29, 37, 214);
    border-top: 1px rgba(87, 219, 244, 86);
    border-bottom: 1px rgba(87, 219, 244, 86);
}

.boss-card-cap-left {
    left: 0;
    transform: skewY(12deg);
    border-left: 1px rgba(87, 219, 244, 86);
}

.boss-card-cap-right {
    right: 0;
    transform: skewY(-12deg);
    border-right: 1px rgba(87, 219, 244, 86);
}

.boss-card-body {
    position: absolute;
    left: 30px;
    top: 0;
    width: 188px;
    height: 434px;
    background-color: rgba(10, 29, 37, 228);
    border: 1px rgba(87, 219, 244, 86);
    box-shadow: 0 0 18px rgba(24, 209, 255, 0.08);
}

.boss-card-body.selected {
    background-color: rgba(14, 40, 49, 236);
    border: 1px rgba(131, 247, 255, 178);
    box-shadow: 0 0 36px rgba(24, 209, 255, 0.18);
}

.boss-card-body.cta-muted {
    box-shadow: 0 0 10px rgba(24, 209, 255, 0.04);
}

.boss-card-status {
    position: absolute;
    left: 14px;
    top: 14px;
    padding: 5px 9px 5px 9px;
    background-color: rgba(8, 24, 30, 214);
    border: 1px rgba(104, 235, 255, 72);
    color: #8edee7;
    font-size: 13px;
}

.boss-card-status.defeated {
    color: #efffff;
    background-color: rgba(18, 118, 114, 178);
    border: 1px rgba(140, 255, 247, 110);
}

.boss-card-portrait {
    position: absolute;
    left: 8px;
    top: 52px;
    width: 172px;
    height: 276px;
    background-color: rgba(10, 23, 29, 255);
    overflow: hidden;
    decorator: none;
}

.boss-card-name {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 62px;
    color: #ffffff;
    font-size: 26px;
    font-weight: bold;
}

.boss-card-subtitle {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 24px;
    color: #7fd6de;
    font-size: 15px;
}

#selector-footer {
    position: absolute;
    left: 80px;
    bottom: 132px;
    width: 650px;
}

#selector-footer-copy {
    color: #6faeb6;
    font-size: 15px;
}

#selector-actions {
    position: absolute;
    left: 50%;
    bottom: 28px;
    width: 438px;
    height: 68px;
    margin-left: -219px;
}

.selector-action-button {
    position: absolute;
    top: 0;
    width: 214px;
    height: 68px;
}

#replay-story-button {
    left: 0;
}

#straight-to-battle-button {
    right: 0;
}

.selector-action-frame {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(10, 29, 37, 214);
    border: 1px rgba(84, 219, 244, 82);
    box-shadow: 0 0 18px rgba(24, 209, 255, 0.08);
}

.selector-action-button.focused .selector-action-frame {
    background-color: rgba(15, 43, 53, 232);
    border: 1px rgba(131, 247, 255, 178);
    box-shadow: 0 0 30px rgba(24, 209, 255, 0.18);
}

.selector-action-inner {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.selector-action-accent {
    position: absolute;
    left: 18px;
    top: 18px;
    width: 10px;
    height: 32px;
    background-color: rgba(255, 255, 255, 72);
    border-radius: 999px;
}

.selector-action-label {
    position: absolute;
    left: 42px;
    top: 24px;
    color: #ffffff;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
    text-transform: uppercase;
}

#selector-toast {
    position: absolute;
    left: 50%;
    bottom: 142px;
    width: 460px;
    margin-left: -230px;
    padding: 12px 18px 12px 18px;
    background-color: rgba(5, 18, 24, 228);
    border: 1px rgba(122, 232, 255, 106);
    color: #ffffff;
    font-size: 15px;
    text-align: center;
    opacity: 0;
}
